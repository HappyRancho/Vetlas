---
import Icon from "./Icon.astro";
import { suggestionEntries } from "@data/search";

interface Props {
  variant?: "hero" | "page" | "compact";
  initialQuery?: string;
  id?: string;
}
const { variant = "hero", initialQuery = "", id } = Astro.props;
const uid = id ?? `us-${Math.random().toString(36).slice(2, 8)}`;
---

<form
  class={`usearch usearch-${variant}`}
  action="/search/"
  method="get"
  role="search"
  aria-label="Search veterinary care"
  data-universal-search
  data-suggestions={`${uid}-data`}
>
  <div class="usearch-field">
    <Icon name="search" class="icon icon-md usearch-icon" />
    <label class="visually-hidden" for={uid}>Search by city, speciality, hospital, clinic or doctor</label>
    <input
      id={uid}
      type="search"
      name="q"
      value={initialQuery}
      placeholder="City, speciality, hospital, clinic or doctor…"
      autocomplete="off"
      enterkeyhint="search"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={`${uid}-panel`}
      aria-haspopup="listbox"
    />
    <button class="usearch-clear" type="button" aria-label="Clear search" hidden>
      <Icon name="x" class="icon icon-md" />
    </button>
    <button class="btn btn-primary usearch-submit" type="submit">
      <span>Search</span>
    </button>
  </div>
  <div class="usearch-panel" id={`${uid}-panel`} role="listbox" aria-label="Search suggestions" hidden></div>
  <p class="usearch-hint">
    Try <button type="button" class="usearch-example" data-q="Dermatology in Bengaluru">Dermatology in Bengaluru</button>
    or <button type="button" class="usearch-example" data-q="24×7 hospital Mumbai">24×7 hospital Mumbai</button>
  </p>
</form>
<script type="application/json" id={`${uid}-data`} set:html={JSON.stringify(suggestionEntries)} />

<script>
  type Entry = {
    kind: string;
    label: string;
    sub: string;
    href: string;
    keywords: string;
  };

  const kindLabel: Record<string, string> = {
    city: "City",
    specialty: "Speciality",
    facility: "Care",
    doctor: "Doctor",
    search: "Search",
  };
  const kindPath: Record<string, string> = {
    city: '<path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/>',
    specialty: '<path d="M4 3v6a5 5 0 0 0 10 0V3"/><path d="M9 14v2a5 5 0 0 0 10 0v-2"/><circle cx="19" cy="11" r="2.2"/>',
    facility: '<path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M16 9h3a2 2 0 0 1 2 2v10M2 21h20"/><path d="M8 7h2M8 11h2M8 15h2"/>',
    doctor: '<circle cx="10" cy="7" r="3.5"/><path d="M3.5 21c0-3.6 2.9-6.5 6.5-6.5 1.6 0 3 .5 4.2 1.4"/><path d="M17 15v3a2.5 2.5 0 0 0 5 0v-1"/><path d="M18.5 12.5 20 14l1.8-1.8"/>',
    search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  };

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (c) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    }[c] as string));
  }

  function normalize(value: string) {
    return value
      .toLowerCase()
      .replace(/×/g, "x")
      .replace(/[^\p{L}\p{N}\s]/gu, " ")
      .replace(/\s+/g, " ")
      .trim();
  }

  function mentions(entry: Entry, query: string) {
    const label = normalize(entry.label);
    if (query.includes(label)) return true;
    const anchor = label.split(" ").find((token) => token.length >= 4);
    return anchor ? query.split(" ").includes(anchor) : false;
  }

  function rank(entry: Entry, rawQuery: string) {
    if (!rawQuery) return 0;
    const query = normalize(rawQuery);
    const label = normalize(entry.label);
    if (label === query) return 0;
    if (label.startsWith(query)) return 1;
    if (label.includes(query)) return 2;
    if (entry.keywords.startsWith(query)) return 3;
    const tokens = query.split(" ").filter(Boolean);
    if (tokens.every((t) => entry.keywords.includes(t))) return 4;
    if (entry.keywords.includes(query)) return 5;
    return 99;
  }

  document.querySelectorAll<HTMLFormElement>("form[data-universal-search]").forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[name="q"]')!;
    const panel = form.querySelector<HTMLElement>(".usearch-panel")!;
    const clear = form.querySelector<HTMLButtonElement>(".usearch-clear")!;
    const dataId = form.dataset.suggestions;
    const dataNode = dataId ? document.getElementById(dataId) : null;
    if (!dataNode) return;

    let entries: Entry[] = [];
    try {
      entries = JSON.parse(dataNode.textContent || "[]") as Entry[];
    } catch {
      entries = [];
    }

    let active = -1;
    let options: HTMLElement[] = [];
    const listId = panel.id;

    function updateClear() {
      clear.hidden = input.value.length === 0;
    }

    function close() {
      panel.hidden = true;
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
      active = -1;
    }

    function draw(query: string) {
      const raw = query.trim();
      const q = normalize(query);
      const matches = (q ? entries : entries.filter((e) => e.kind === "city" || e.kind === "specialty"))
        .map((entry) => ({ entry, score: rank(entry, q) }))
        .filter((item) => item.score < 99)
        .sort((a, b) => a.score - b.score || a.entry.label.localeCompare(b.entry.label))
        .slice(0, 8)
        .map((item) => item.entry);

      if (raw) {
        const nearCity = entries.find((e) => e.kind === "city" && mentions(e, q));
        const nearSpec = entries.find((e) => e.kind === "specialty" && mentions(e, q));
        if (nearCity && nearSpec) {
          const citySlug = nearCity.href.replace(/^\//, "").replace(/\/$/, "");
          const specSlug = nearSpec.href.replace(/^\/specialties\//, "").replace(/\/$/, "");
          matches.unshift({
            kind: "specialty",
            label: `${nearSpec.label} in ${nearCity.label}`,
            sub: "City × speciality page",
            href: `/${citySlug}/${specSlug}/`,
            keywords: "",
          });
        }
        matches.unshift({
          kind: "search",
          label: `Search for “${raw}”`,
          sub: "See every matching hospital, clinic and doctor",
          href: `/search/?q=${encodeURIComponent(raw)}`,
          keywords: "",
        });
      }

      active = -1;
      options = [];
      panel.innerHTML = "";

      if (matches.length === 0) {
        const empty = document.createElement("p");
        empty.className = "usearch-empty";
        empty.textContent = "No suggestion — press Search to see matching care.";
        panel.appendChild(empty);
      } else {
        matches.forEach((entry, index) => {
          const option = document.createElement("div");
          option.className = "usearch-option";
          option.id = `${listId}-opt-${index}`;
          option.setAttribute("role", "option");
          option.setAttribute("aria-selected", "false");
          option.dataset.href = entry.href;
          option.dataset.index = String(index);
          option.innerHTML = `
            <span class="usearch-option-icon usearch-kind-${entry.kind}" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${kindPath[entry.kind] ?? kindPath.facility}</svg>
            </span>
            <span class="usearch-option-text">
              <b>${escapeHtml(entry.label)}</b>
              <small>${escapeHtml(entry.sub)}</small>
            </span>
            <span class="usearch-option-kind">${kindLabel[entry.kind] ?? "Result"}</span>
          `;
          option.addEventListener("mousedown", (event) => event.preventDefault());
          option.addEventListener("click", () => {
            window.location.assign(entry.href);
          });
          panel.appendChild(option);
          options.push(option);
        });
      }

      panel.hidden = false;
      input.setAttribute("aria-expanded", "true");
    }

    function select(index: number) {
      const option = options[index];
      if (!option) return;
      active = index;
      options.forEach((o, i) => o.setAttribute("aria-selected", String(i === index)));
      input.setAttribute("aria-activedescendant", option.id);
      option.scrollIntoView({ block: "nearest" });
    }

    function emit() {
      document.dispatchEvent(new CustomEvent("usearch:input", { detail: { value: input.value, form } }));
    }

    input.addEventListener("focus", () => draw(input.value));
    input.addEventListener("input", () => {
      draw(input.value);
      updateClear();
      emit();
    });
    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        if (panel.hidden) draw(input.value);
        select(Math.min(active + 1, options.length - 1));
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        select(Math.max(active - 1, 0));
      } else if (event.key === "Enter" && active >= 0) {
        event.preventDefault();
        const href = options[active]?.dataset.href;
        if (href) window.location.assign(href);
      } else if (event.key === "Escape") {
        close();
      } else if (event.key === "Tab") {
        close();
      }
    });
    input.addEventListener("blur", () => window.setTimeout(close, 120));

    clear.addEventListener("click", () => {
      input.value = "";
      updateClear();
      close();
      input.focus();
      emit();
      document.dispatchEvent(new CustomEvent("usearch:clear", { detail: { form } }));
    });

    form.querySelectorAll<HTMLButtonElement>(".usearch-example").forEach((example) => {
      example.addEventListener("click", () => {
        input.value = example.dataset.q || "";
        updateClear();
        input.focus();
        emit();
        draw(input.value);
      });
    });

    // Restore a shared query: /search/?q=…
    const urlQuery = new URLSearchParams(window.location.search).get("q");
    if (!input.value && urlQuery) input.value = urlQuery;
    updateClear();
  });
</script>
