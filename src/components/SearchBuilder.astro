---
import Icon from "./Icon.astro";
import { cities, specialties } from "@data";

/**
 * Sentence-driven search builder (spec §7):
 * "My [pet] needs a [speciality] in [city]" → GET /search/ with params.
 * Works without JavaScript; the /search page resolves the combination.
 */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const petTypes = [
  { v: "dog", l: "dog" },
  { v: "cat", l: "cat" },
  { v: "bird", l: "bird" },
  { v: "rabbit", l: "rabbit" },
];
---

<form class="search-builder" action="/search/" method="get" role="search" aria-label="Find veterinary care">
  <label class="sb-text" for={compact ? "sb-pet-c" : "sb-pet"}>My</label>
  <select class="sb-select" id={compact ? "sb-pet-c" : "sb-pet"} name="pet">
    {petTypes.map((p) => <option value={p.v}>{p.l}</option>)}
  </select>
  <label class="sb-text visually-hidden" for={compact ? "sb-spec-c" : "sb-spec"}>needs a speciality</label>
  <span class="sb-text">needs a</span>
  <select class="sb-select" id={compact ? "sb-spec-c" : "sb-spec"} name="speciality">
    {specialties.map((s) => <option value={s.slug}>{s.name.toLowerCase()}</option>)}
  </select>
  <label class="sb-text visually-hidden" for={compact ? "sb-city-c" : "sb-city"}>in city</label>
  <span class="sb-text">in</span>
  <select class="sb-select" id={compact ? "sb-city-c" : "sb-city"} name="city">
    {cities.map((c) => <option value={c.slug}>{c.name}</option>)}
  </select>
  <button type="submit" class="btn btn-primary">
    <Icon name="search" class="icon icon-md" />
    Find care
  </button>
</form>

<script>
  /**
   * Build the combination URL directly (spec §6 URL structure):
   * /{city}/{speciality}/ — works on static hosting where query params
   * are dropped. Without JS the form falls back to /search/.
   */
  document.querySelectorAll<HTMLFormElement>("form.search-builder").forEach((form) => {
    form.addEventListener("submit", (e) => {
      const city = form.querySelector<HTMLSelectElement>('select[name="city"]')?.value;
      const speciality = form.querySelector<HTMLSelectElement>('select[name="speciality"]')?.value;
      if (city && speciality) {
        e.preventDefault();
        window.location.assign(`/${city}/${speciality}/`);
      }
    });
  });
</script>
