---
import { consultationLabel, hoursLabel } from '../lib/visit-info.mjs';
import { providers } from '@data';
import { vetsForFacility } from '../data/veterinarians';
import { googleDirections, googlePreview } from '../lib/map-links.mjs';
import { summarizeRatings } from '../lib/ratings.mjs';
import VetNames from './VetNames.astro';
import RatingSummary from './RatingSummary.astro';
const facilities=providers.filter(p=>p.cityId==='indore'&&p.coordinates);
const services=[...new Set(facilities.flatMap(p=>p.services))].sort();
const species=[...new Set(facilities.flatMap(p=>p.species))].sort();
const records=facilities.map(p=>({...p,href:`/indore/${p.slug}/`,preview:googlePreview(p),directions:googleDirections(p),doctorNames:vetsForFacility(p.id).flatMap(v=>[v.name,...v.aliases]),ratingSummary:summarizeRatings(p.platformRatings)}));
---
<section class="care-map" id="care-map">
 <form class="care-map-filters" role="search" aria-label="Filter mapped clinics">
  <label class="map-search">Find a clinic or doctor<input name="q" type="search" placeholder="Clinic, doctor, locality or treatment…" autocomplete="off" /></label>
  <label>Service<select name="service"><option value="">All services</option>{services.map(s=><option value={s}>{s}</option>)}</select></label>
  <label>Pet<select name="pet"><option value="">All pets</option>{species.map(s=><option value={s}>{s}</option>)}</select></label>
  <div class="map-toggles"><label><input type="checkbox" name="emergency" /> Advertises emergency care</label><label><input type="checkbox" name="fee" /> Published consultation fee</label></div>
 </form>
 <div class="map-actions"><button type="button" class="btn btn-primary" data-nearby>Nearest to me</button><button type="button" class="btn btn-secondary" data-fit>Fit results</button><button type="button" class="btn btn-secondary" data-reset>Reset</button><button type="button" class="btn btn-secondary" data-share>Copy view link</button><div class="mobile-map-switch" role="group" aria-label="View results"><button type="button" data-view="list" aria-pressed="true">List</button><button type="button" data-view="map" aria-pressed="false">Map</button></div></div>
 <p class="map-results-status" role="status" data-map-status>{facilities.length} clinics · sourced locations · confirm hours before travelling</p>
 <div class="care-map-grid" data-mobile-view="list">
  <div class="map-results" aria-label="Clinic results"><p data-map-empty hidden class="notice-box">No matching clinics. Try another service or clear a filter.</p>{facilities.map((p,i)=><article data-map-result={p.id} class="map-result">
   <div class="map-result-head">{p.imageUrl && <img src={p.imageUrl} alt={p.imageAlt||p.name} width="64" height="64" loading="lazy"/>}<div><span class="map-number">{i+1}</span><h2><a href={`/indore/${p.slug}/`}>{p.name}</a></h2><p>{p.area}</p></div></div>
   <VetNames id={p.id}/><RatingSummary provider={p} compact/>
   <p class="map-result-meta"><strong>{consultationLabel(p).amount} · {consultationLabel(p).caption}</strong><span data-distance></span></p>
   <p class="small muted">{hoursLabel(p)}</p>
   <div class="map-result-actions"><button type="button" data-select={p.id} aria-pressed="false">Show on map</button>{p.phone&&<a href={`tel:${p.phone.replace(/[^+\d]/g,'')}`}>Call</a>}<a href={googleDirections(p)} target="_blank" rel="noreferrer">Directions →</a><a href={`/indore/${p.slug}/`}>Details →</a></div>
   {p.imageUrl && <a class="map-photo-credit" href={p.imageSourceUrl} target="_blank" rel="noreferrer">Photo: {p.imageCredit}</a>}
  </article>)}</div>
  <div class="map-stage">
   <div class="map-canvas" id="clinic-map" role="region" aria-label="Interactive map of Indore veterinary clinics" tabindex="0"><p data-map-loading>Loading map… Clinic details and Google Maps directions are available in the list.</p></div>
   <p class="small muted" data-tile-status>Map: OpenStreetMap · Clinic locations: public Google Maps listings / linked practice map.</p>
   <section class="map-selected" aria-label="Selected clinic" hidden><div class="map-selected-top"><div><span class="eyebrow">Plan your visit</span><h2 data-selected-name></h2><p data-selected-address></p></div><a data-selected-profile class="btn btn-secondary">Full profile →</a></div><p data-selected-note class="small muted"></p>
    <div class="map-route-controls"><label>Travel<select data-travel><option value="driving">Drive</option><option value="walking">Walk</option><option value="transit">Public transport</option><option value="bicycling">Cycle</option></select></label><a data-selected-directions class="btn btn-primary" target="_blank" rel="noreferrer">Route in Google Maps →</a><a data-selected-source target="_blank" rel="noreferrer">Location source →</a></div>
    <details data-google-preview><summary>Google Maps preview</summary><iframe title="Selected clinic Google Maps preview" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></details>
   </section>
   <p class="map-guidance">Pins use branch map links or published Plus Codes (approximately 14 m cells). Check the entrance and current address with the clinic. Nearby distances are straight-line estimates; Google Maps provides available routes and travel times.</p>
  </div>
 </div>
 <noscript><p class="notice-box">Interactive filters need JavaScript. All clinic profiles, phone numbers and directions above work without it.</p></noscript>
 <script type="application/json" id="map-records" set:html={JSON.stringify(records).replace(/</g,'\\u003c')}/>
</section>
<script>import '../scripts/care-map.mjs';</script>
<style is:global>
.care-map{margin:1.2rem 0 2.5rem}.care-map [hidden]{display:none!important}.care-map-filters{display:grid;grid-template-columns:2fr 1fr 1fr;gap:.7rem;background:linear-gradient(120deg,#dff4ee,#edf4fc);border:1px solid #cce5dc;border-radius:20px;padding:1rem}.care-map-filters label,.map-route-controls label{display:grid;gap:.3rem;font-size:.75rem;font-weight:600;min-width:0}.care-map-filters input[type=search],.care-map select{font:inherit;padding:.65rem;min-height:44px;border:1px solid #c4ddd4;border-radius:10px;background:#fff;color:#183f38;width:100%;min-width:0}.map-toggles{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.6rem 1.2rem}.map-toggles label{display:flex;align-items:center;gap:.4rem;min-height:30px}.map-toggles input{accent-color:#008c83;width:17px;height:17px}.map-actions{display:flex;gap:.5rem;flex-wrap:wrap;margin:.8rem 0}.map-actions .btn{font-size:.76rem;padding:.65rem .85rem}.map-results-status{font-size:.8rem;color:#405e60;min-height:1.5rem}.care-map-grid{display:grid;grid-template-columns:minmax(300px,.85fr) minmax(0,1.3fr);gap:1rem;align-items:start}.map-results{max-height:850px;overflow:auto;scroll-margin-top:85px;padding:2px 6px 6px 2px}.map-result{background:white;border:1px solid #deebe6;border-radius:18px;padding:.9rem;margin-bottom:.7rem;transition:border-color .15s,box-shadow .15s;scroll-margin-top:10px}.map-result.is-selected{border-color:#008c83;box-shadow:0 0 0 2px #008c8322;background:#f5fcfa}.map-result-head{display:flex;gap:.7rem;align-items:center;margin-bottom:.5rem}.map-result-head img{border-radius:12px;object-fit:cover;flex-shrink:0}.map-result h2{font-size:.95rem;margin:0;line-height:1.35;display:inline}.map-result-head p{font-size:.72rem;margin:.2rem 0;color:#586c70}.map-number{font-size:.65rem;font-weight:700;background:#daf0e8;color:#00675e;border-radius:7px;padding:.15rem .3rem;margin-right:.3rem}.map-result-meta{font-size:.73rem;margin:.6rem 0 .3rem;display:flex;flex-wrap:wrap;justify-content:space-between;gap:.4rem}.map-result .small{font-size:.7rem;margin:.3rem 0}.map-result-actions{display:flex;flex-wrap:wrap;gap:.35rem}.map-result-actions>*{font:inherit;font-size:.69rem;display:inline-flex;align-items:center;min-height:40px;padding:.4rem .55rem;border-radius:9px;background:#edf8f3;border:1px solid #d5e9df;color:#006c61;cursor:pointer}.map-photo-credit{display:block;font-size:.58rem;color:#627473;margin-top:.4rem;overflow-wrap:anywhere}.map-canvas{height:460px;border-radius:20px;border:1px solid #cde4da;background:#e7f1ed;z-index:0}.map-canvas>p{padding:1.2rem;font-size:.85rem}.map-stage{min-width:0}.map-stage>p{font-size:.68rem;line-height:1.5;margin:.5rem .2rem}.map-selected{background:white;padding:1rem;border:1px solid #d6e8df;border-radius:18px;margin-top:.6rem}.map-selected [data-selected-note]{font-size:.72rem;line-height:1.5}.map-selected h2{font-size:1rem;margin:.3rem 0}.map-selected-top{display:flex;justify-content:space-between;gap:.7rem}.map-selected-top p{font-size:.75rem;margin:.3rem 0}.map-selected-top .btn{font-size:.68rem;flex-shrink:0;align-self:start;padding:.55rem}.map-route-controls{display:flex;gap:.65rem;align-items:end;flex-wrap:wrap}.map-route-controls>a{font-size:.72rem}.map-route-controls label{width:130px}.map-selected details{margin-top:.9rem;font-size:.8rem}.map-selected summary{cursor:pointer;color:#00786c;font-weight:600;padding:.4rem 0}.map-selected iframe{width:100%;height:230px;border:0;border-radius:12px;margin-top:.5rem}.vet-map-pin{background:none;border:0}.vet-map-pin span{display:grid;place-items:center;width:29px;height:29px;border:2px solid white;border-radius:50% 50% 50% 4px;transform:rotate(-45deg);background:#007e74;color:white;box-shadow:0 2px 8px #173f3b55;font:700 12px Inter,sans-serif}.vet-map-pin b{transform:rotate(45deg)}.vet-map-pin.selected span{background:#bd4f20;width:34px;height:34px}.mobile-map-switch{display:none}.map-guidance{background:#edf6f2;border-radius:10px;padding:.7rem}.leaflet-container a{color:#006c61}.leaflet-popup-content{font:500 13px/1.5 Inter,sans-serif;max-width:230px}.leaflet-popup-content a{display:block;margin-top:7px;text-decoration:underline}.leaflet-control-attribution{font-size:10px!important}@media(max-width:760px){.care-map-filters{grid-template-columns:1fr 1fr}.map-search{grid-column:1/-1}.care-map-grid{grid-template-columns:1fr}.map-results{max-height:none}.map-canvas{height:390px}.mobile-map-switch{display:flex;margin-left:auto;background:white;border:1px solid #cde4da;border-radius:12px;padding:3px}.mobile-map-switch button{min-height:38px;padding:.4rem .8rem;border:0;background:transparent;border-radius:9px;color:#006d62;font:600 .75rem Inter,sans-serif}.mobile-map-switch button[aria-pressed=true]{background:#daf0e8}.care-map-grid[data-mobile-view=list] .map-stage{display:none}.care-map-grid[data-mobile-view=map] .map-results{display:none}.map-selected-top{flex-wrap:wrap}.map-toggles label{font-size:.7rem}.map-actions .btn{font-size:.68rem;padding:.55rem .65rem}}
</style>
