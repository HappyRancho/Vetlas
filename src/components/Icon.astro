---
/**
 * Dependency-free inline icon set (stroke style, 24px grid).
 * Mirrors the paths used across the app; `name` selects the glyph.
 */
interface Props {
  name: string;
  class?: string;
  size?: "sm" | "md" | "lg" | "xl";
  style?: string;
}
const { name, class: className = "icon", size, style } = Astro.props;

