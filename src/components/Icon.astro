const specialityAlias: Record<string, string> = {
  paw: "paw", scissors: "scissors", siren: "siren", tooth: "tooth", drop: "drop",
  bone: "bone", stethoscope: "stethoscope", eye: "eye", shield: "shield",
  bird: "bird", wave: "wave", scan: "scan", heart: "heart",
};

const path = specialityAlias[name] ?? icons[name] ?? icons.paw;
const sizeClass = size ? ` icon-${size}` : "";
---

<svg
  class={`${className}${sizeClass}`}
  style={style}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={path}
/>
