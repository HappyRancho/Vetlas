---
import {ownerArticles, guideChapters} from '../data/owner-guides';
const groups = [
  {label:"Sick & recovering",items:ownerArticles.filter(a=>a.group==="sick")},
  {label:"Preventive care",items:ownerArticles.filter(a=>a.group==="preventive")}
];
---
{groups.map(group=><section class="guide-group"><h2>{group.label}</h2><nav aria-label={group.label}>
  {group.items.map(a=><a class="article-link" href={'/care-guide/'+a.slug+'/'}>
    <img src={a.image} alt="" loading="lazy" width="240" height="152"/>
    <span><small>{a.topic}</small><strong>{a.title}</strong></span>
  </a>)}
</nav></section>)}
<nav class="care-referrals" aria-label="Referral guide chapters">{guideChapters.map(c=><a href={c.href}>{c.label}</a>)}</nav>
<style>
.guide-group nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
.article-link{display:grid;grid-template-columns:minmax(80px,32%) 1fr;align-items:center;border:1px solid var(--rule);border-radius:13px;overflow:hidden;background:white;color:var(--ink);text-decoration:none}
.article-link img{width:100%;height:100%;min-height:100px;object-fit:cover}.article-link span{padding:10px}
.article-link small,.article-link strong{display:block}.article-link small{font-size:.82rem;color:var(--teal);margin-bottom:5px}.article-link strong{font:600 1.15rem/1.18 Georgia,serif}
.care-referrals{display:flex;flex-wrap:wrap;gap:6px;margin:16px 0}.care-referrals a{display:inline-flex;align-items:center;min-height:42px;padding:6px 11px;border:1px solid var(--rule);border-radius:10px;background:white;color:var(--teal);font-weight:650}
@media(max-width:650px){.guide-group nav{grid-template-columns:1fr}}
</style>
