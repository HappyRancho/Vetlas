---
import { cities } from "@data";
interface Props { expanded?: boolean; }
const { expanded = false } = Astro.props;
---
<details class="directory-map" open={expanded}>
  <summary><span>⌖ Map preview <small>Explore the area before you go</small></span><span>Open map →</span></summary>
  <div class="map-content">
    <div class="map-toolbar"><label>Explore city <select id="map-city">{cities.map(c => <option value={c.slug}>{c.name}</option>)}</select></label><button type="button" class="btn btn-primary" id="map-nearby">Use my location</button><a id="map-external" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" href="https://www.google.com/maps/search/veterinary+clinics+India">Open in Google Maps →</a></div>
    <iframe id="area-map" title="City and neighbourhood map preview" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    <p id="map-status" role="status">Area preview only. Sample facilities are not plotted as real locations.</p>
  </div>
</details>
<script>
 const select = document.querySelector<HTMLSelectElement>('#map-city');
 const frame = document.querySelector<HTMLIFrameElement>('#area-map');
 const external = document.querySelector<HTMLAnchorElement>('#map-external');
 const details = document.querySelector<HTMLDetailsElement>('.directory-map');
 if(select && frame && external && details) {
   const params = new URLSearchParams(location.search);
   if(Array.from(select.options).some(o => o.value === params.get('city'))) select.value = params.get('city')!;
   let area = params.get("q") || "";
   function update() {
     if(!select || !frame || !external || !details?.open) return;
     const city = select.selectedOptions[0]?.textContent || 'India';
     const q = `${area ? area + ", " : ""}${city}, India`;
     const src = `https://maps.google.com/maps?q=${encodeURIComponent(q)}&z=12&output=embed`;
     if(frame.src !== src) frame.src = src;
     external.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('veterinary clinics ' + q)}`;
   }
   select.addEventListener('change', () => { area = ''; update(); });
   details.addEventListener('toggle', update);
   document.addEventListener('directory:filtered', ((event: CustomEvent) => {
     if(event.detail.city && Array.from(select.options).some(o => o.value === event.detail.city)) select.value = event.detail.city;
     update();
   }) as EventListener);
   document.getElementById('map-nearby')?.addEventListener('click', () => {
     const status = document.getElementById('map-status')!;
     if (!navigator.geolocation) { status.textContent = 'Location is unavailable. Choose a city instead.'; return; }
     status.textContent = 'Finding your location…';
     navigator.geolocation.getCurrentPosition(position => {
       const q = `${position.coords.latitude},${position.coords.longitude}`;
       frame.src = `https://maps.google.com/maps?q=${encodeURIComponent(q)}&z=14&output=embed`;
       external.href = `https://www.google.com/maps/search/veterinary+clinics/@${q},14z`;
       status.textContent = 'Your area preview. Open Google Maps to explore nearby clinics; directory sample listings are not location-verified.';
     }, () => { status.textContent = 'Could not access your location. Choose a city to explore instead.'; }, { timeout: 10000, maximumAge: 60000 });
   });
   update();
 }
</script>
