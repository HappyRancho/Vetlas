---
import Icon from "./Icon.astro";
import { cities } from "@data";
interface Props { path: string; isCurrent: (href: string) => boolean }
const { path } = Astro.props;
const segment = path.split("/")[1];
const items = [
  { label: "Home", href: "/", icon: "home", active: !segment },
  { label: "Find", href: "/search/", icon: "search", active: ["search","hospitals","clinics","doctors","specialists","specialties","emergency","map"].includes(segment) },
  { label: "City", href: "/locations/", icon: "pin", active: segment === "locations" || cities.some(c => c.slug === segment) },
  { label: "Guide", href: "/care-guide/", icon: "book", active: ["care-guide","guides","reads","finds"].includes(segment) },
  { label: "More", href: "/more/", icon: "dots", active: ["more","about","methodology","review","privacy","rankings"].includes(segment) }
];
---
<nav class="bottom-nav" aria-label="Quick navigation">
  {items.map(item => <a href={item.href} aria-current={item.active ? (item.href === path ? "page" : "location") : undefined}><Icon name={item.icon} class="icon icon-md"/><span>{item.label}</span></a>)}
</nav>
