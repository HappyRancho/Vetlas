---
import Wordmark from "./Wordmark.astro";
import Icon from "./Icon.astro";

interface Props {
  path: string;
}
const { path } = Astro.props;

const nav = [
  { href: "/search/", label: "Directory" },
  { href: "/specialties/", label: "Specialities" },
  { href: "/locations/", label: "Cities" },
  { href: "/care-guide/", label: "Care guide" },
  { href: "/doctors/", label: "Veterinarians" },
];

const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <Wordmark />

    <nav class="site-nav" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="header-icon-link" href="/about/" aria-label="About Vetlas and the data policy">
        <Icon name="info" class="icon icon-md" />
      </a>
      <a class="urgent-link" href="/emergency/"><Icon name="siren" class="icon"/> Emergency</a>
    </div>
  </div>
</header>
