---
import Wordmark from "./Wordmark.astro";
import Icon from "./Icon.astro";

interface Props {
  path: string;
}
const { path } = Astro.props;

const nav = [
  { href: "/search/", label: "Directory" },
  { href: "/categories/", label: "Categories" },

  { href: "/care-guide/", label: "Care guide" },
  { href: "/doctors/", label: "Veterinarians" },
  { href: "/more/", label: "More" },
];

const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <div class="brand-stamp"><Wordmark /><span class="brand-purpose">Veterinary directory</span></div>

    <nav class="site-nav" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} data-more-trigger={item.href==="/more/" ? "" : undefined} aria-current={isCurrent(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="header-icon-link" href="/search/" aria-label="Search veterinary care">
        <Icon name="search" class="icon icon-md" />
      </a>
      <a class="urgent-link" href="/emergency/"><Icon name="siren" class="icon"/> Emergency</a>
    </div>
  </div>
</header>
