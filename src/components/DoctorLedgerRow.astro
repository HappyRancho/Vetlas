---
import { cityById, specialtyById, feeINR, type Doctor } from "@data";

interface Props {
  doctor: Doctor;
  index: number;
  theme?: string;
}
const { doctor, index, theme } = Astro.props;
const city = cityById(doctor.cityId);
const primary = specialtyById(doctor.primarySpecialtyId);
---

<li class="ledger-row animate-fade-up" style={`animation-delay:${Math.min(index, 8) * 50}ms`}>
  <span class="ledger-num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
  <span class="ledger-main">
    <a class="ledger-name" href={`/${city?.slug}/${doctor.slug}/`}>Dr. {doctor.name}</a>
    <span class="ledger-meta">
      <span class="dot">{primary?.name}</span>
      <span class="dot">{doctor.experienceYears} yrs exp</span>
      <span class="dot">{city?.name}</span>
    </span>
    <span class="ledger-meta">{doctor.degrees.join(" · ")}</span>
  </span>
  {theme && <span class="ledger-theme" title={theme}>“{theme}”</span>}
  <span class="ledger-fee">
    {feeINR(doctor.consultationFee)}
    <small>consultation</small>
  </span>
</li>
