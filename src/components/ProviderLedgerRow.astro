---
import { cityById, specialtyById, feeINR, type Provider } from "@data";

interface Props {
  provider: Provider;
  index: number;
  /** Optional single theme to surface in the ledger line (spec: themes over stars) */
  theme?: string;
}
const { provider, index, theme } = Astro.props;
const city = cityById(provider.cityId);
---

<li class="ledger-row animate-fade-up" style={`animation-delay:${Math.min(index, 8) * 50}ms`}>
  <span class="ledger-num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
  <span class="ledger-main">
    <a class="ledger-name" href={`/${city?.slug}/${provider.slug}/`}>{provider.name}</a>
    <span class="ledger-meta">
      <span class="dot">{provider.area}, {city?.name}</span>
      <span class="dot" style="text-transform:capitalize">{provider.type}</span>
      {provider.hours.open24 && <span class="dot" style="color:var(--teal);font-weight:600">Open 24×7</span>}
    </span>
    <span class="ledger-meta">
      {provider.specialtyIds.slice(0, 3).map((id) => specialtyById(id)?.name).filter(Boolean).join(" · ")}
    </span>
  </span>
  {theme && <span class="ledger-theme" title={theme}>“{theme}”</span>}
  <span class="ledger-fee">
    {provider.fees ? feeINR(provider.fees.opd) : "Not verified"}
    <small>consultation</small>
  </span>
</li>
