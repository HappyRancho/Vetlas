---
import Icon from "./Icon.astro";
import FacilityMedia from "./FacilityMedia.astro";
import VetNames from "./VetNames.astro";
import RatingSummary from "./RatingSummary.astro";
import TrustBadge from "./TrustBadge.astro";
import { cityById, specialtyById, feeINR, type Provider } from "@data";

interface Props {
  provider: Provider;
  featured?: boolean;
  index?: number;
}
const { provider, featured = false, index = 0 } = Astro.props;
const city = cityById(provider.cityId);
const specs = provider.specialtyIds
  .map((id) => specialtyById(id)?.name)
  .filter((name): name is string => Boolean(name));
const hours = provider.hours.open24
  ? "Open 24×7"
  : provider.hours.open && provider.hours.close
    ? `${provider.hours.open}–${provider.hours.close}`
    : "Hours not listed";
const highlights = [...specs.slice(0, 1), ...provider.services.slice(0, 2)];
---

<article class={`facility-card${featured ? " facility-card-featured" : ""}`} style={`animation-delay:${Math.min(index, 8) * 45}ms`}>
  <div class="facility-media"><FacilityMedia provider={provider} /></div>
  <div class="facility-body">
    <div class="facility-top">
      <TrustBadge level={provider.dataSource} />
      <RatingSummary provider={provider} compact />
    </div>

    <h3 class="facility-name">
      <a href={`/${city?.slug}/${provider.slug}/`}>{provider.name}</a>
    </h3>
    <VetNames id={provider.id} />

    <p class="facility-location">
      <Icon name="pin" class="icon" />
      {provider.area}, {city?.name}
      <span class="meta-sep">·</span>
      <span class="facility-hours"><Icon name="clock" class="icon" />{hours}</span>
    </p>

    <ul class="facility-tags" aria-label="Services and facilities">
      {highlights.map((item) => <li>{item}</li>)}
    </ul>

    {provider.feeNote && <p class="small muted">{provider.feeNote}</p>}
    <div class="quick-actions">
      <button class="save-facility" type="button" data-save={provider.id} aria-pressed="false" aria-label={`Save ${provider.name}`}>♡ Save</button>
      {provider.phone && provider.dataSource !== "sample" && <a class="btn btn-primary" href={`tel:${provider.phone.replace(/[^+\d]/g, "")}`}>Call clinic</a>}
      <a class="btn btn-secondary" href={`/map/?city=${city?.slug}&${provider.coordinates ? `clinic=${provider.id}` : `q=${encodeURIComponent(provider.area)}`}`}>{provider.coordinates ? "Clinic map" : "Area map"} <Icon name="pin" class="icon" /></a>
    </div>
    <div class="facility-footer">
      <div class="facility-fee">
        {provider.fees ? <><b>{provider.feeIsStarting ? "From " : ""}{feeINR(provider.fees.opd)}</b><span>consultation · {provider.dataSource === "sample" ? "sample" : "listed"}</span></> : <><b>Not verified</b><span>consultation fee</span></>}
      </div>
      <a class="facility-action" href={`/${city?.slug}/${provider.slug}/`}>
        View profile <Icon name="arrow" class="icon" />
      </a>
    </div>
  </div>
</article>

<script>
  const key = 'vetlas-saved';
  function saved(): string[] { try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch { return []; } }
  function paint() { const ids = saved(); document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach(button => { const active = ids.includes(button.dataset.save!); button.setAttribute('aria-pressed', String(active)); button.textContent = active ? '♥ Saved' : '♡ Save'; }); }
  document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach(button => button.addEventListener('click', () => {
    const ids = saved(); const id = button.dataset.save!;
    try { localStorage.setItem(key, JSON.stringify(ids.includes(id) ? ids.filter(v => v !== id) : [...ids, id])); paint(); }
    catch { button.textContent = 'Saving unavailable'; }
  }));
  paint();
  window.addEventListener('storage', paint);
</script>
