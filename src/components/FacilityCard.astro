---
import Icon from './Icon.astro';
import { googleDirections } from '../lib/map-links.mjs';
import VetNames from './VetNames.astro';
import RatingSummary from './RatingSummary.astro';
import { cityById, specialtyById, type Provider } from '@data';
import { consultationLabel, hoursLabel } from '../lib/visit-info.mjs';
interface Props { provider: Provider; featured?: boolean; index?: number; }
const {provider}=Astro.props;
const city=cityById(provider.cityId),href=`/${city?.slug}/${provider.slug}/`,fee=consultationLabel(provider);
const specs=provider.specialtyIds.map(id=>specialtyById(id)?.name).filter(Boolean);
const highlights=[...new Set([...specs.slice(0,1),...provider.services.filter(s=>s!=='Consultation')])].slice(0,3);
---
<article class="listing">
  <div class="listing-heading">
    {provider.imageUrl && <img class="listing-photo" src={provider.imageUrl} alt={provider.imageAlt} width="80" height="60" loading="lazy" />}
    <p class="kicker">{provider.type === "ngo" ? "Animal welfare" : provider.type} · {city?.name}</p>
    <h3><a href={href}>{provider.name}</a></h3>
    <p class="listing-area"><Icon name="pin" class="icon"/>{provider.area}</p>
  </div>
  {highlights.length>0 && <p class="listing-services">{highlights.join(" · ")}</p>}
  <VetNames id={provider.id}/>
  {provider.platformRatings?.length && <RatingSummary provider={provider} compact/>}
  <div class="listing-visit"><span>{provider.hoursNote && !provider.visitHours && !provider.hours.open ? provider.hoursNote.split(" · ")[0].slice(0,64) : hoursLabel(provider)}</span>{provider.fees && <strong>{fee.amount}</strong>}</div>
  <div class="listing-actions"><a href={href}>Details →</a>{provider.phone && <a href={`tel:${provider.phone.replace(/[^+\d]/g,"")}`}>Call</a>}{!provider.locationUnconfirmed && <a href={googleDirections(provider)}>Directions</a>}
    <button type="button" data-save={provider.id} aria-pressed="false" aria-label={`Save ${provider.name}`}><Icon name="heart" class="icon"/><span data-save-label>Save</span></button></div>
</article>
<script>
 const key='vetlas-saved';
 function saved():string[]{try{const ids=JSON.parse(localStorage.getItem(key)||'[]');return Array.isArray(ids)?ids.filter(id=>typeof id==='string'):[];}catch{return [];}}
 function paint(){const ids=saved();document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach(button=>{const active=ids.includes(button.dataset.save!);button.setAttribute('aria-pressed',String(active));button.querySelector('[data-save-label]')!.textContent=active?'Saved':'Save';});}
 document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach(button=>button.addEventListener('click',()=>{const ids=saved(),id=button.dataset.save!;try{localStorage.setItem(key,JSON.stringify(ids.includes(id)?ids.filter(v=>v!==id):[...ids,id]));paint();}catch{button.querySelector('[data-save-label]')!.textContent='Unavailable';}}));paint();window.addEventListener('storage',paint);
</script>
