---
import { providers, feeINR } from '@data';
import Icon from './Icon.astro';
import type { Veterinarian } from '../data/veterinarians';
interface Props { vet: Veterinarian; }
const {vet}=Astro.props;
const practice=providers.find(p=>vet.providerIds.includes(p.id));
---
<article class="vet-card">
 <div class="vet-card-top"><span class="vet-symbol"><Icon name="doctor" class="icon icon-xl" /></span><div><span class="eyebrow">Public-source profile</span><h3><a href={`/indore/veterinarians/${vet.slug}/`}>Dr. {vet.name}</a></h3><p>{vet.area}, Indore</p></div></div>
 <p class="vet-focus">{vet.focus.join(' · ')}</p><p class="vet-practice">{vet.practice}</p>
 <p class="small muted">{vet.qualifications.length?vet.qualifications.join(' · '):'Qualifications not confirmed'} · Sources on profile</p>
 <div class="vet-card-bottom"><div><strong>{practice?.fees?`${practice.feeIsStarting?'From ':''}${feeINR(practice.fees.opd)}`:'Call to confirm'}</strong><small>{practice?.fees?'Listed practice consultation · indicative':'Consultation fee & availability'}</small></div><a class="btn btn-secondary" href={`/indore/veterinarians/${vet.slug}/`}>View doctor →</a></div>
</article>
<style>.vet-card{height:100%;padding:1.1rem;background:linear-gradient(145deg,#fff,#f5fcfa);border:1px solid #d9ebe6;border-radius:22px;box-shadow:0 5px 18px #173f3b06;display:flex;flex-direction:column;gap:.65rem;min-width:0}.vet-card p{margin:0}.vet-card p.small{font-size:.73rem;line-height:1.5}.vet-card-top{display:flex;gap:.7rem;align-items:center}.vet-symbol{flex-shrink:0;display:grid;place-items:center;background:#dff4ee;color:#007c73;width:48px;height:48px;border-radius:16px}.vet-card h3{font-size:1.08rem;margin:.15rem 0;line-height:1.3}.vet-card .eyebrow{font-size:.62rem}.vet-card-top p,.vet-practice{font-size:.82rem;color:#50636d}.vet-focus{color:#007c73;font-size:.83rem;font-weight:600}.vet-card-bottom{display:flex;gap:.5rem;align-items:center;justify-content:space-between;margin-top:auto;padding-top:.7rem;border-top:1px solid #e4efea}.vet-card-bottom strong{font-size:.88rem}.vet-card-bottom small{display:block;font-size:.65rem;max-width:180px;color:#52666e}.vet-card-bottom .btn{font-size:.72rem;padding:.6rem .7rem;white-space:nowrap}</style>
