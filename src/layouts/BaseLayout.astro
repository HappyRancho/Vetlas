---
import "../styles/global.css";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/inter";
import Icon from "../components/Icon.astro";
import { cities, specialties } from "@data";

interface Props {
  title: string;
  description: string;
  /** SEO indexability gate (spec §6): unvetted content is noindex */
  noindex?: boolean;
  canonical?: string;
}
const { title, description, noindex = false, canonical } = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = canonical ? new URL(canonical, siteUrl) : Astro.url;
const year = new Date().getFullYear();
const path = Astro.url.pathname;

const nav = [
  { href: "/search/", label: "Find care", icon: "search" },
  { href: "/specialties/", label: "Specialities", icon: "stethoscope" },
  { href: "/locations/", label: "Cities", icon: "pin" },
  { href: "/about/", label: "About", icon: "info" },
  { href: "/costs/", label: "Cost guide", icon: "wallet" },
];

const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#eff6ff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site guide" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vetlas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    {
      noindex === false && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            name: "Vetlas",
            url: String(siteUrl),
            description:
              "India's veterinary care discovery platform — find clinics, hospitals and doctors with clearly attributed data.",
          })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="beta-strip">
      <div class="container beta-strip-inner">
        <span class="beta-tag">Beta</span>
        <p>
          Sample listings only. Every profile, fee and review is clearly marked demo data —
          <a href="/about/">read the data policy</a>.
        </p>
      </div>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Vetlas home">
          <span class="brand-mark"><Icon name="paw" class="icon" /></span>
          <span class="brand-word">Vetlas</span>
        </a>

        <nav class="site-nav" aria-label="Primary">
          {nav.slice(0, 4).map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="header-actions">
          <a class="header-icon-link" href="/search/" aria-label="Search veterinary care">
            <Icon name="search" class="icon icon-md" />
          </a>
          <a class="btn btn-primary header-cta" href="/search/">Find care</a>
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
            <Icon name="menu" class="icon icon-md" />
          </button>
        </div>
      </div>

      <nav class="mobile-nav" id="mobile-nav" hidden aria-label="Mobile">
        {nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
            <Icon name={item.icon} class="icon icon-md" />
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/">
            <span class="brand-mark"><Icon name="paw" class="icon" /></span>
            <span class="brand-word">Vetlas</span>
          </a>
          <p>
            A calmer way to find veterinary care in India. Discover hospitals, clinics and doctors,
            compare what matters, and choose with confidence.
          </p>
          <p class="footer-fineprint">Beta · sample data only · free to use</p>
        </div>
        <nav class="footer-col" aria-label="Popular specialities">
          <h2>Specialities</h2>
          <ul>
            {specialties.slice(0, 5).map((s) => (
              <li><a href={`/specialties/${s.slug}/`}>{s.name}</a></li>
            ))}
          </ul>
        </nav>
        <nav class="footer-col" aria-label="Cities">
          <h2>Cities</h2>
          <ul>
            {cities.slice(0, 6).map((c) => (
              <li><a href={`/${c.slug}/`}>Vets in {c.name}</a></li>
            ))}
          </ul>
        </nav>
        <nav class="footer-col" aria-label="Vetlas">
          <h2>Vetlas</h2>
          <ul>
            <li><a href="/search/">Find care</a></li>
            <li><a href="/costs/">Cost guide</a></li>
            <li><a href="/methodology/">How data is checked</a></li>
            <li><a href="/about/">About &amp; data policy</a></li>
          </ul>
        </nav>
      </div>
      <div class="footer-bottom">
        <div class="container">
          <p>© {year} Vetlas. Made for India's pets and their people.</p>
          <p>Not a veterinary provider. In an emergency, contact a clinic directly.</p>
        </div>
      </div>
    </footer>

    <nav class="bottom-nav" aria-label="Quick navigation">
      <a href="/" aria-current={path === "/" ? "page" : undefined}>
        <Icon name="home" class="icon icon-md" />
        <span>Home</span>
      </a>
      <a href="/search/" aria-current={isCurrent("/search/") ? "page" : undefined}>
        <Icon name="search" class="icon icon-md" />
        <span>Search</span>
      </a>
      <a href="/specialties/" aria-current={isCurrent("/specialties/") ? "page" : undefined}>
        <Icon name="stethoscope" class="icon icon-md" />
        <span>Specialities</span>
      </a>
      <a href="/locations/" aria-current={isCurrent("/locations/") ? "page" : undefined}>
        <Icon name="pin" class="icon icon-md" />
        <span>Cities</span>
      </a>
    </nav>

    <script>
      const btn = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const nav = document.querySelector<HTMLElement>("#mobile-nav");
      if (btn && nav) {
        btn.addEventListener("click", () => {
          const open = btn.getAttribute("aria-expanded") === "true";
          btn.setAttribute("aria-expanded", String(!open));
          btn.setAttribute("aria-label", open ? "Open menu" : "Close menu");
          nav.toggleAttribute("hidden", open);
        });
      }
    </script>
  </body>
</html>
