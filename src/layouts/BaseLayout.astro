---
import "../styles/global.css";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/inter";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BottomNav from "../components/BottomNav.astro";

interface Props {
  title: string;
  description: string;
  /** SEO indexability gate (spec §6): unvetted content is noindex */
  noindex?: boolean;
  canonical?: string;
}
const { title, description, noindex = false, canonical } = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const canonicalUrl = canonical ? new URL(canonical, siteUrl) : Astro.url;
const path = Astro.url.pathname;

const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7faf8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site guide" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vetlas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    {
      noindex === false && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            name: "Vetlas",
            url: String(siteUrl),
            description:
              "India's veterinary care discovery platform — find clinics, hospitals and doctors with clearly attributed data.",
          })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader path={path} />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />

    <BottomNav path={path} isCurrent={isCurrent} />
  </body>
</html>
