---
import DirectoryHeader from "../components/DirectoryHeader.astro";
import TopicLinks from "../components/TopicLinks.astro";
import { guideTopics } from "../data/owner-guides";
import Layout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

import { providers } from "@data";

const at = (id: string) => {
  const practice = providers.find(p => p.id === id)!;
  return "/" + practice.cityId + "/" + practice.slug + "/";
};
const tata = at("mumbai-tata-trusts-small-animal-hospital-mahalaxmi-saat-rasta");
const madras = at("chennai-madras-veterinary-college-teaching-hospital-tanuvas-vepery");
const jivdaya = at("ahmedabad-jivdaya-charitable-trust-animal-hospital-ambawadi-panjrapol-campus");
const brands = ["Crown Vet","Vetic","Zigly"].map(name => ({
  name, branches:providers.filter(p=>p.name.startsWith(name))
}));
---
<Layout title="Animal owner guide to veterinary care in India" description="Prepare for a visit with guides to pet behaviour and nutrition, specialist referrals, teaching hospitals and wildlife rescue in India.">
<div class="container guide">
<Breadcrumbs items={[{name:"Home",href:"/"},{name:"Care guide",href:"/care-guide/"}]}/>
<DirectoryHeader label="Vetlas field guide" title="Guide for animal owners" description="Prepare for your pet’s next visit or find the right referral for a specialist, farm animal or wildlife case."/>
<TopicLinks items={guideTopics} label="Animal owner guide topics"/>
<section id="referral"><h2>Specialist referrals</h2><div class="guide-grid"><article><h3>Cancer treatment</h3><p>Small Animal Hospital Mumbai lists oncology, pathology, imaging and surgery at its Mahalaxmi hospital. At Urban Pet Centre’s Juhu practice, Dr. Prajakta’s published services include chemotherapy and surgery for cancer cases. When booking, ask which reports or tissue samples to bring.</p><a href={tata}>Mahalaxmi hospital and team →</a><a href="/specialties/oncology/">Find oncology care →</a><a href="https://urbanpetcentre.co.in/">Urban Pet Centre’s Juhu services ↗</a></article>
<article><h3>Eye care</h3><p>The Mumbai hospital also lists ophthalmology. Call to confirm the eye clinic’s next session and whether the team can see your animal that day. For an urgent injury, contact an emergency department while arranging the visit.</p><a href="/specialties/ophthalmology/">Browse eye care →</a><a href="https://sahmumbai.com/">Hospital departments ↗</a></article></div></section>
<section id="teaching"><h2>Teaching hospitals & dairy institutions</h2><div class="guide-grid"><article><h3>Madras Veterinary College, Chennai</h3><p>TANUVAS publishes outpatient hours of 8 am–1 pm on weekdays and 8 am–11:30 am on weekends and government holidays. Its Vepery hospital provides round-the-clock emergency care for large and small animals. Seven-day registration costs ₹100 for small animals and ₹20 for large animals. Call before arranging transport for livestock.</p><a href={madras}>Address and visit details →</a><a href="https://tanuvas.ac.in/mvc_clinics.php">University timetable and fees ↗</a></article>
<article><h3>ICAR–National Dairy Research Institute, Karnal</h3><p>NDRI works in dairy research, training and extension. Contact the institute directly about herd-health or research enquiries. For an animal needing treatment today, use a veterinary hospital that confirms it can receive the animal.</p><a href="https://ndri.res.in/">Official institute directory ↗</a><a href="/search/?pet=livestock">Explore livestock care →</a></article></div></section>
<section id="networks"><h2>Private hospitals & care networks</h2><p>Services and clinician schedules vary by branch. Open a branch profile to check its address, care offered and visit costs.</p>
<div class="guide-grid"><article><h3>Tata Trusts Small Animal Hospital</h3><p>The Mahalaxmi campus brings intensive care, advanced imaging, dialysis and multiple speciality departments together. Its clinical roster names each veterinarian’s qualifications and interests.</p><a href={tata}>Hospital profile →</a><a href="/mumbai/veterinarians/">Mumbai veterinarians →</a></article>
{brands.map(b=><article><h3>{b.name}</h3><ul>{b.branches.filter((p,i,all)=>all.findIndex(q=>q.cityId===p.cityId)===i).slice(0,4).map(p=><li><a href={'/'+p.cityId+'/'+p.slug+'/'}>{p.area} · {p.cityId}</a></li>)}</ul><a href={'/search/?q='+encodeURIComponent(b.name)}>Find another branch →</a></article>)}</div>
<p class="guide-note"><strong>Heads Up For Tails</strong> lists stores and grooming services. Confirm a veterinary appointment with a named clinic before travelling for medical care. <a href="https://headsupfortails.com/pages/store-locator">HUFT store locator ↗</a></p></section>
<section id="rescue"><h2>Community animals & wildlife</h2><div class="guide-grid"><article><h3>Jivdaya Charitable Trust, Ahmedabad</h3><p>The Ambawadi hospital provides charitable treatment for unowned animals and birds. Contact the trust about intake and transport for an injured animal.</p><a href={jivdaya}>Hospital and directions →</a></article><article><h3>Vantara, Jamnagar</h3><p>Vantara is a wildlife rescue, rehabilitation and conservation centre. For a wild animal in distress, contact the local forest department or an authorised rescue service for handling and transfer instructions.</p><a href="https://vantara.in/">Vantara’s conservation work ↗</a></article></div></section>
</div></Layout>
<style>
.guide header{margin-bottom:12px}.guide{padding-bottom:2rem;max-width:1020px}.guide h1{margin:.3rem 0}.guide header p{max-width:63ch}.guide section{scroll-margin-top:85px;margin-top:1.5rem}.guide section h2{font:720 clamp(1.3rem,3vw,1.85rem)/1.15 var(--display);margin:0 0 .65rem}.guide h3{margin:0;font-size:1.08rem;color:#123c47}.guide p{line-height:1.55}.guide-jumps{display:flex;gap:6px;flex-wrap:wrap;margin:14px 0}.guide-jumps a,.guide article>a{display:inline-flex;align-items:center;gap:6px;min-height:40px;padding:5px 8px;font-size:.86rem}.guide-jumps a{border:1px solid var(--rule);background:white;border-radius:8px}.guide-jumps svg{width:17px;height:17px}.guide-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.guide article{background:white;border:1px solid var(--rule);border-top:3px solid #71a99d;padding:clamp(13px,2.5vw,20px);border-radius:12px}.guide article p,.guide-note{font-size:.92rem;margin:.6rem 0}.guide article>a{padding-left:0;margin-right:8px;color:var(--teal);text-decoration:underline}.guide article ul{padding-left:1.2rem}.guide article li{padding-block:3px}.guide-note{padding:12px;background:#e8f2ec;border-radius:8px}@media(max-width:620px){.guide-grid{grid-template-columns:1fr}.guide section{margin-top:1.25rem}}
</style>
