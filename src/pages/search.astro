---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import UniversalSearch from "../components/UniversalSearch.astro";
import FacilityCard from "../components/FacilityCard.astro";
import DoctorCard from "../components/DoctorCard.astro";
import TrustBadge from "../components/TrustBadge.astro";
import {
  cities, specialties, providers, doctors, cityById, specialtyById,
} from "@data";

const speciesOptions = [
  { v: "dog", l: "Dogs" },
  { v: "cat", l: "Cats" },
  { v: "bird", l: "Birds" },
  { v: "rabbit", l: "Rabbits" },
  { v: "hamster", l: "Hamsters" },
];

interface Row {
  kind: "facility" | "doctor";
  type: string;
  name: string;
  href: string;
  city: string;
  specialty: string;
  species: string;
  fee: number;
  rating: number;
  blob: string;
}

const rows: Row[] = [
  ...providers.map((p): Row => {
    const city = cityById(p.cityId)!;
    const specs = p.specialtyIds.map((id) => specialtyById(id));
    return {
      kind: "facility",
      type: p.type,
      name: p.name,
      href: `/${city.slug}/${p.slug}/`,
      city: city.slug,
      specialty: [
        ...p.specialtyIds,
        ...specs.map((s) => s?.slug).filter(Boolean),
      ].join(" "),
      species: p.species.join(" "),
      fee: p.fees?.opd ?? 0,
      rating: p.rating ?? 0,
      blob: [
        p.name, p.area, city.name, city.slug, p.type, p.type === "hospital" ? "hospital" : "clinic",
        ...specs.map((s) => `${s?.name} ${s?.slug}`),
        ...p.services, ...p.species, ...p.amenities,
        p.hours.open24 ? "24x7 24 hours emergency open" : "open",
      ].join(" ").toLowerCase(),
    };
  }),
  ...doctors.map((d): Row => {
    const city = cityById(d.cityId)!;
    const specIds = [d.primarySpecialtyId, ...d.secondarySpecialtyIds];
    const specs = specIds.map((id) => specialtyById(id));
    return {
      kind: "doctor",
      type: "doctor",
      name: `Dr. ${d.name}`,
      href: `/${city.slug}/${d.slug}/`,
      city: city.slug,
      specialty: [
        ...specIds,
        ...specs.map((s) => s?.slug).filter(Boolean),
      ].join(" "),
      species: d.species.join(" "),
      fee: d.consultationFee,
      rating: d.rating,
      blob: [
        `Dr ${d.name}`, d.name, "doctor vet veterinarian specialist",
        ...specs.map((s) => `${s?.name} ${s?.slug}`),
        city.name, city.slug, ...d.degrees, ...d.species, ...d.languages,
      ].join(" ").toLowerCase(),
    };
  }),
];
---

<BaseLayout
  title="Find veterinary care — Vetlas"
  description="One search for veterinary hospitals, clinics and doctors across India. Search by city, speciality, facility or doctor name, then refine by type, city and animal."
  canonical="/search/"
>
  <div class="container">
    <header class="search-hero">
      <p class="eyebrow"><Icon name="search" class="icon icon-md" /> One search, every kind of care</p>
      <h1>Find the right care</h1>
      <p class="search-hero-sub">
        Type a city, speciality, hospital, clinic or doctor. Vetlas understands the mix and shows
        the closest matches first.
      </p>
      <UniversalSearch variant="page" />
      <ul class="search-signals" aria-label="Search supports">
        <li><Icon name="pin" class="icon" />City or area</li>
        <li><Icon name="stethoscope" class="icon" />Speciality</li>
        <li><Icon name="building" class="icon" />Hospital or clinic</li>
        <li><Icon name="doctor" class="icon" />Doctor</li>
      </ul>
    </header>

    <section class="search-shell" aria-label="Filter results">
      <div class="filter-bar">
        <div class="filter-types" role="group" aria-label="Filter by type">
          <button class="filter-chip" type="button" data-type="" aria-pressed="true">All care</button>
          <button class="filter-chip" type="button" data-type="hospital" aria-pressed="false">Hospitals</button>
          <button class="filter-chip" type="button" data-type="clinic" aria-pressed="false">Clinics</button>
          <button class="filter-chip" type="button" data-type="doctor" aria-pressed="false">Doctors</button>
        </div>

        <div class="filter-selects">
          <label class="filter-select">
            <span>City</span>
            <select id="f-city">
              <option value="">All cities</option>
              {cities.map((c) => <option value={c.slug}>{c.name}</option>)}
            </select>
          </label>
          <label class="filter-select">
            <span>Speciality</span>
            <select id="f-spec">
              <option value="">All specialities</option>
              {specialties.map((s) => <option value={s.slug} data-id={s.id}>{s.name}</option>)}
            </select>
          </label>
          <label class="filter-select">
            <span>Sort</span>
            <select id="f-sort">
              <option value="relevance">Best match</option>
              <option value="rating">Top rated</option>
              <option value="fee-asc">Fee: low to high</option>
              <option value="fee-desc">Fee: high to low</option>
              <option value="name">Name A–Z</option>
            </select>
          </label>
        </div>
      </div>

      <fieldset class="species-filter">
        <legend>Treats</legend>
        <div class="species-chips">
          {speciesOptions.map((s) => (
            <label class="chip chip-toggle">
              <input type="checkbox" name="species" value={s.v} />
              {s.l}
            </label>
          ))}
        </div>
      </fieldset>

      <div class="search-toolbar">
        <p class="result-count" id="result-count" role="status" aria-live="polite">
          <span id="result-count-text">Showing <b>{rows.length}</b> of <b>{rows.length}</b> public listings</span>
        </p>
        <div class="search-toolbar-actions">
          <TrustBadge level="public" label="Public source" />
          <button type="button" class="text-button" id="clear-filters">Clear all</button>
        </div>
      </div>
    </section>

    <p class="search-intent" id="search-intent" hidden></p>

    <ol class="result-list" id="search-results">
      {rows.map((r, i) => (
        <li
          class="result-item"
          data-kind={r.kind}
          data-type={r.type}
          data-city={r.city}
          data-specialty={r.specialty}
          data-species={r.species}
          data-fee={r.fee}
          data-rating={r.rating}
          data-name={r.name.toLowerCase()}
          data-blob={r.blob}
        >
          {r.kind === "facility"
            ? <FacilityCard provider={providers.find((p) => `/${cityById(p.cityId)?.slug}/${p.slug}/` === r.href)!} index={i} />
            : <DoctorCard doctor={doctors.find((d) => `/${cityById(d.cityId)?.slug}/${d.slug}/` === r.href)!} index={i} />}
        </li>
      ))}
    </ol>

    <div class="empty-state" id="no-results" hidden>
      <span class="icon-wrap"><Icon name="search" class="icon icon-xl" /></span>
      <h2>No matches yet</h2>
      <p>Try a nearby city, a broader speciality, or clear a filter or two.</p>
      <div class="actions">
        <button type="button" class="btn btn-primary" id="clear-search-filters">Clear search &amp; filters</button>
      </div>
    </div>

    <section class="section" aria-labelledby="ways-h">
      <div class="section-head">
        <div>
          <p class="section-eyebrow">Still browsing</p>
          <h2 class="section-title" id="ways-h">Other ways in</h2>
        </div>
      </div>
      <ul class="tile-grid">
        <li><a class="card card-hover" href="/specialties/"><span class="card-icon"><Icon name="stethoscope" class="icon icon-lg" /></span><span><b>By speciality</b><span>Surgery, dermatology, emergency care and more</span></span></a></li>
        <li><a class="card card-hover" href="/locations/"><span class="card-icon"><Icon name="pin" class="icon icon-lg" /></span><span><b>By city</b><span>Metros first, expanding nationwide</span></span></a></li>
        <li><a class="card card-hover" href="/costs/"><span class="card-icon amber"><Icon name="wallet" class="icon icon-lg" /></span><span><b>Typical costs</b><span>Broad ranges for common care in India</span></span></a></li>
      </ul>
    </section>
  </div>

  <script>
    const results = document.getElementById("search-results") as HTMLOListElement | null;
    if (results) {
      const list: HTMLOListElement = results;
      const rows = Array.from(list.querySelectorAll<HTMLLIElement>(".result-item"));
      const city = document.getElementById("f-city") as HTMLSelectElement;
      const spec = document.getElementById("f-spec") as HTMLSelectElement;
      const sort = document.getElementById("f-sort") as HTMLSelectElement;
      const typeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-chip"));
      const speciesBoxes = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="species"]'));
      const count = document.getElementById("result-count-text")!;
      const intent = document.getElementById("search-intent") as HTMLElement;
      const empty = document.getElementById("no-results") as HTMLElement;
      const clearAll = document.getElementById("clear-filters");
      const clearSearch = document.getElementById("clear-search-filters");
      const params = new URLSearchParams(window.location.search);
      const total = rows.length;
      let type = params.get("type") || "";
      let query = (params.get("q") || "").trim();

      const cityName = (slug: string) => city.querySelector<HTMLOptionElement>(`option[value="${slug}"]`)?.textContent || slug;
      const specName = (slug: string) => spec.querySelector<HTMLOptionElement>(`option[value="${slug}"]`)?.textContent || slug;

      if (params.get("city")) city.value = params.get("city")!;
      if (params.get("speciality")) spec.value = params.get("speciality")!;
      if (params.get("sort")) sort.value = params.get("sort")!;
      const pet = params.get("pet");
      if (pet) {
        const box = speciesBoxes.find((b) => b.value === pet);
        if (box) box.checked = true;
      }
      typeButtons.forEach((b) => {
        const isActive = (b.dataset.type || "") === type;
        b.setAttribute("aria-pressed", String(isActive));
      });

      function setType(next: string) {
        type = next;
        typeButtons.forEach((b) => b.setAttribute("aria-pressed", String((b.dataset.type || "") === type)));
        apply();
      }

      function detectIntent() {
        if (!query) {
          intent.hidden = true;
          return;
        }
        const q = query.toLowerCase();
        const foundCity = Array.from(city.options).find((o) => o.value && q.includes(o.value)) ||
          Array.from(city.options).find((o) => o.value && q.includes(o.textContent!.toLowerCase()));
        const foundSpec = Array.from(spec.options).find((o) => o.value && q.includes(o.value)) ||
          Array.from(spec.options).find((o) => o.value && q.includes(o.textContent!.toLowerCase()));
        const kind = /\b(hospital|hospitals)\b/.test(q) ? "hospitals"
          : /\b(clinic|clinics)\b/.test(q) ? "clinics"
          : /\b(doctor|doctors|vet|vets|specialist|specialists)\b/.test(q) ? "doctors"
          : "";
        const bits = [
          foundCity ? `city: ${cityName(foundCity.value)}` : "",
          foundSpec ? `speciality: ${specName(foundSpec.value)}` : "",
          kind ? `looking for: ${kind}` : "",
        ].filter(Boolean);
        intent.innerHTML = bits.length
          ? `<span class="intent-label">Understood</span> ${bits.join(" · ")}. Refine below if needed.`
          : `<span class="intent-label">Searching all care</span> for “${query.replace(/[<>&"']/g, "")}” across every city.`;
        intent.hidden = false;
      }

      function updateUrl() {
        const next = new URLSearchParams();
        if (query) next.set("q", query);
        if (type) next.set("type", type);
        if (city.value) next.set("city", city.value);
        if (spec.value) next.set("speciality", spec.value);
        if (sort.value !== "relevance") next.set("sort", sort.value);
        const animal = speciesBoxes.find((b) => b.checked)?.value;
        if (animal) next.set("pet", animal);
        const nextQuery = next.toString();
        history.replaceState(null, "", nextQuery ? `?${nextQuery}` : window.location.pathname);
      }

      function apply() {
        const normalized = query
          .toLowerCase()
          .replace(/×/g, "x")
          .replace(/[^\p{L}\p{N}\s]/gu, " ")
          .replace(/\s+/g, " ")
          .trim();
        const stopWords = new Set([
          "a", "an", "and", "at", "for", "in", "me", "near", "of", "the", "to", "with",
          "vet", "vets", "veterinarian", "veterinary",
        ]);
        const tokens = normalized ? normalized.split(" ").filter((t) => t && !stopWords.has(t)) : [];
        const wantedSpecies = speciesBoxes.filter((b) => b.checked).map((b) => b.value);
        let shown = 0;

        for (const row of rows) {
          const d = row.dataset;
          let ok = true;
          if (type && d.type !== type) ok = false;
          if (ok && city.value && d.city !== city.value) ok = false;
          if (ok && spec.value) {
            const specValues = (d.specialty ?? "").split(" ");
            if (!specValues.includes(spec.value)) {
              const option = spec.querySelector<HTMLOptionElement>(`option[value="${spec.value}"]`);
              if (!option || !specValues.includes(option.dataset.id ?? "")) ok = false;
            }
          }
          if (ok && wantedSpecies.length) {
            const has = (d.species ?? "").split(" ");
            ok = wantedSpecies.some((s) => has.includes(s));
          }
          if (ok && tokens.length) {
            const blob = d.blob ?? "";
            ok = tokens.every((t) => blob.includes(t));
          }
          row.hidden = !ok;
          if (ok) shown++;
        }

        const relevance = (row: HTMLLIElement) => {
          if (!query) return 0;
          const name = row.dataset.name ?? "";
          if (name === query.toLowerCase()) return 0;
          if (name.startsWith(query.toLowerCase())) return 1;
          if (name.includes(query.toLowerCase())) return 2;
          return 3;
        };

        const cmp: Record<string, (a: HTMLLIElement, b: HTMLLIElement) => number> = {
          relevance: (a, b) => relevance(a) - relevance(b) || Number(b.dataset.rating) - Number(a.dataset.rating),
          rating: (a, b) => Number(b.dataset.rating) - Number(a.dataset.rating),
          "fee-asc": (a, b) => Number(a.dataset.fee) - Number(b.dataset.fee),
          "fee-desc": (a, b) => Number(b.dataset.fee) - Number(a.dataset.fee),
          name: (a, b) => (a.dataset.name ?? "").localeCompare(b.dataset.name ?? ""),
        };
        const comparator = cmp[sort.value] ?? cmp.relevance!;
        const visible = rows.filter((r) => !r.hidden).sort(comparator);
        visible.forEach((r) => list.appendChild(r));

        count.innerHTML = `Showing <b>${shown}</b> of <b>${total}</b> public listings`;
        empty.hidden = shown > 0;
        list.hidden = shown === 0;
        detectIntent();
        updateUrl();
      }

      function clearEverything() {
        query = "";
        const input = document.querySelector<HTMLInputElement>("form[data-universal-search] input[name='q']");
        if (input) {
          input.value = "";
          const clear = document.querySelector<HTMLButtonElement>(".usearch-clear");
          if (clear) clear.hidden = true;
        }
        city.value = "";
        spec.value = "";
        sort.value = "relevance";
        type = "";
        typeButtons.forEach((b) => b.setAttribute("aria-pressed", String((b.dataset.type || "") === "")));
        speciesBoxes.forEach((b) => (b.checked = false));
        apply();
      }

      typeButtons.forEach((button) => button.addEventListener("click", () => setType(button.dataset.type || "")));
      city.addEventListener("change", apply);
      spec.addEventListener("change", apply);
      sort.addEventListener("change", apply);
      speciesBoxes.forEach((b) => b.addEventListener("change", apply));
      clearAll?.addEventListener("click", clearEverything);
      clearSearch?.addEventListener("click", clearEverything);

      document.addEventListener("usearch:input", (event) => {
        query = (event as CustomEvent<{ value: string }>).detail.value.trim();
        apply();
      });
      document.addEventListener("usearch:clear", () => {
        query = "";
        apply();
      });
      document.addEventListener("submit", (event) => {
        const form = (event.target as HTMLElement).closest("form[data-universal-search]");
        if (form) {
          event.preventDefault();
          const input = form.querySelector<HTMLInputElement>("input[name='q']");
          query = (input?.value || "").trim();
          apply();
          document.querySelector(".search-shell")?.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });

      apply();
    }
  </script>
</BaseLayout>
