---
import BaseLayout from '../layouts/BaseLayout.astro';
import { providers, feeINR } from '@data';
---
<BaseLayout title="Indore vet consultation fees & visit cost planner — Vetlas" description="Compare attributed consultation prices, see source conflicts and plan additional veterinary expenses in Indore.">
<div class="container cost-page"><p class="eyebrow">Know before you go · Indore</p><h1>A clearer idea of the cost.</h1><p>Select clinics to compare published consultation figures. These are source-listed prices, not confirmed quotes or a representative city average.</p>
<div class="cost-layout"><section class="panel"><h2>1. Choose consultation listings</h2>
{providers.map(p => <label class="cost-choice"><input type="checkbox" data-fee={p.fees?.opd} data-starting={p.feeIsStarting ? '1':'0'} disabled={!p.fees} checked={!!p.fees && !p.feeIsStarting}/><span><b>{p.name}</b><small>{p.fees ? `${p.feeIsStarting ? 'From ' : ''}${feeINR(p.fees.opd)} · source-listed` : 'No comparable price available'} · checked {p.lastChecked}</small>{p.feeNote && <small>{p.feeNote}</small>}<a href={`/indore/${p.slug}/`}>View fee sources →</a></span></label>)}
<p class="notice-box">Selecting “from” prices includes starting figures in the comparison; the result is not an average final consultation charge. Conflicting and missing prices are excluded, never treated as ₹0.</p></section>
<section class="panel"><h2>2. Add visit options</h2><p>Optional amounts are your own budget estimates. We do not yet have comparable Indore price evidence for these services.</p>
{['Vaccination','Blood tests','Imaging / X-ray','Medication','Home visit / travel','Emergency surcharge'].map((name,i) => <label class="cost-choice"><input type="checkbox" data-extra-toggle={i}/><span>{name}<input type="number" data-extra={i} min="0" max="1000000" step="1" placeholder="Enter quoted or budgeted ₹" aria-label={`${name} budget in rupees`} disabled /></span></label>)}
<div class="cost-summary" role="status" aria-live="polite"><p id="fee-average"></p><p id="fee-range"></p><p id="cost-total"></p></div><p class="small muted">No treatment recommendation or clinic quote. Ask whether medicine, taxes, follow-up and diagnostics are included.</p></section></div></div>
</BaseLayout>
<script>
 const choices = Array.from(document.querySelectorAll<HTMLInputElement>('[data-fee]'));
 const extras = Array.from(document.querySelectorAll<HTMLInputElement>('[data-extra]'));
 function update() {
  const selected = choices.filter(c=>c.checked&&!c.disabled);const values=selected.map(c=>Number(c.dataset.fee));
  const mean=values.length ? values.reduce((a,b)=>a+b,0)/values.length : null;
  const starting=selected.some(c=>c.dataset.starting==='1');
  document.getElementById('fee-average')!.textContent=mean===null?'Select a priced clinic to compare.':`Selected ${starting?'listed / starting figures':'listed consultation fees'}: mean ₹${Math.round(mean)} · n=${values.length}`;
  document.getElementById('fee-range')!.textContent=values.length?`Selected range: ₹${Math.min(...values)}–₹${Math.max(...values)}. ${values.length<3?'Small sample; not a city benchmark.':''}`:'';
  const enabled=extras.filter(e=>!e.disabled);const incomplete=enabled.some(e=>!e.value||!e.validity.valid);
  const added=enabled.reduce((a,e)=>a+(Number(e.value)||0),0);
  document.getElementById('cost-total')!.textContent=incomplete?'Enter a valid amount for each selected option.':mean===null?`Your additional budget: ₹${added}`:`Illustrative budget: ₹${Math.round(mean+added)} (selected mean + your ₹${added} options)`;
 }
 document.querySelectorAll<HTMLInputElement>('[data-extra-toggle]').forEach(toggle=>toggle.addEventListener('change',()=>{document.querySelector<HTMLInputElement>(`[data-extra="${toggle.dataset.extraToggle}"]`)!.disabled=!toggle.checked;update();}));
 [...choices,...extras].forEach(input=>input.addEventListener('input',update));update();
</script>
