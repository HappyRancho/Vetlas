---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VetCard from '../../../components/VetCard.astro';
import { veterinarians } from '../../../data/veterinarians';
const base=Astro.site!.origin;
const schema={'@context':'https://schema.org','@type':'ItemList',name:'Veterinarians in Indore',itemListOrder:'https://schema.org/ItemListOrderAscending',numberOfItems:veterinarians.length,itemListElement:veterinarians.map((v,i)=>({'@type':'ListItem',position:i+1,name:`Dr. ${v.name}`,url:`${base}/indore/veterinarians/${v.slug}/`}))};
---
<BaseLayout noindex={!veterinarians.length} title="Veterinarians in Indore — doctors, clinics & consultation fees | Vetlas" description="Compare published veterinarian qualifications and practice affiliations in Indore. Explore practices, map locations, fees and sources.">
 <script type="application/ld+json" set:html={JSON.stringify(schema)} />
 <div class="container vets-page">
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Indore',href:'/indore/'},{name:'Veterinarians',href:'/indore/veterinarians/'}]}/>
  <header><p class="eyebrow">The person behind your pet’s care</p><h1>Veterinarians in Indore</h1><p>Find a doctor by name, area or care offered. Compare practices, consultation charges and clinic locations.</p><div class="list-inline"><a class="chip" href="/map/">Explore the clinic map →</a><a class="chip" href="/costs/">Understand treatment costs →</a></div></header>
  <div class="vet-controls"><label>Search doctors<input id="vet-search" type="search" placeholder="Name, locality or field of care…" /></label><label>Care offered<select id="vet-focus"><option value="">All care</option><option value="surgery">Surgery</option><option value="medicine">Medicine</option><option value="preventive">Preventive care</option><option value="radiology">Radiology</option></select></label><label>Practice location<select id="vet-practice"><option value="">All profiles</option><option value="mapped">Linked clinic & map</option></select></label></div>
  <p class="small muted" id="vet-count" role="status">{veterinarians.length} veterinarians · compare practices and care offered</p>
  <div class="vet-grid">{veterinarians.map(v=><div data-vet-row data-search={[v.name,...v.aliases,v.area,v.practice,...v.focus].join(' ').toLowerCase()} data-focus={v.focus.join(' ').toLowerCase()} data-mapped={String(v.providerIds.length>0)}><VetCard vet={v}/></div>)}</div>
  <p id="vet-empty" class="notice-box" hidden>No matching doctors. Try a surname or remove a filter.</p>
  {!veterinarians.length && <p>Veterinarian profiles will appear here once their portraits are cleared for publication.</p>}
 </div>
</BaseLayout>
<script>
 const search=document.querySelector<HTMLInputElement>('#vet-search')!,focus=document.querySelector<HTMLSelectElement>('#vet-focus')!,practice=document.querySelector<HTMLSelectElement>('#vet-practice')!;
 const rows=Array.from(document.querySelectorAll<HTMLElement>('[data-vet-row]'));
 const params=new URLSearchParams(location.search);search.value=params.get('q')||'';
 function filter(){let count=0;const q=search.value.toLowerCase().trim().split(/\s+/);rows.forEach(row=>{const match=q.every(term=>(row.dataset.search||'').includes(term))&&(!focus.value||(row.dataset.focus||'').includes(focus.value))&&(!practice.value||row.dataset.mapped==='true');row.hidden=!match;if(match)count++;});document.querySelector('#vet-count')!.textContent=`${count} of ${rows.length} profiles · alphabetical by name`;document.querySelector<HTMLElement>('#vet-empty')!.hidden=count>0;}
 [search,focus,practice].forEach(el=>el.addEventListener('input',filter));filter();
</script>
<style>.vets-page{padding-bottom:3rem}.vets-page header{padding:1.3rem 0}.vets-page h1{font-size:clamp(1.8rem,5vw,3rem);margin:.5rem 0}.vets-page header>p{max-width:760px}.vet-controls{display:grid;grid-template-columns:2fr 1fr 1fr;gap:.7rem;background:#e5ecf5;border:1px solid #d2ddeb;padding:1rem;border-radius:20px}.vet-controls label{font-size:.75rem;font-weight:600;display:grid;gap:.35rem}.vet-controls input,.vet-controls select{width:100%;min-width:0;min-height:44px;padding:.6rem;border:1px solid #c7d2e1;border-radius:10px;background:white;font:inherit}.vet-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.vet-faq{max-width:850px;margin:2rem auto}.vet-faq details{border-bottom:1px solid #d8dfe8;padding:1rem 0}.vet-faq summary{font-weight:600;cursor:pointer}.vet-faq p{font-size:.9rem;color:#465877}@media(max-width:620px){.vet-grid{grid-template-columns:1fr}.vet-controls{grid-template-columns:1fr 1fr}.vet-controls label:first-child{grid-column:1/-1}}</style>
