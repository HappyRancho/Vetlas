---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VetCard from '../../../components/VetCard.astro';
import { veterinarians } from '../../../data/veterinarians';
const base='https://vetlas.thatvetguy.net';
const schema={'@context':'https://schema.org','@type':'ItemList',name:'Veterinarians in Indore',itemListOrder:'https://schema.org/ItemListOrderAscending',numberOfItems:veterinarians.length,itemListElement:veterinarians.map((v,i)=>({'@type':'ListItem',position:i+1,name:`Dr. ${v.name}`,url:`${base}/indore/veterinarians/${v.slug}/`}))};
---
<BaseLayout title="Veterinarians in Indore — doctors, clinics & consultation fees | Vetlas" description="Compare 9 Indore veterinarians including H. K. Mehta, B. P. Shukla, Narendra Chouhan and Harendra Rajput. Explore practices, map locations, fees and sources.">
 <script type="application/ld+json" set:html={JSON.stringify(schema)} />
 <div class="container vets-page">
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:'Indore',href:'/indore/'},{name:'Veterinarians',href:'/indore/veterinarians/'}]}/>
  <header><p class="eyebrow">The person behind your pet’s care</p><h1>Veterinarians in Indore</h1><p>Find a doctor by name, area or care offered. Compare practices, consultation charges and clinic locations.</p><div class="list-inline"><a class="chip" href="/map/">Explore 15 clinics on the map →</a><a class="chip" href="/costs/">Understand treatment costs →</a></div></header>
  <div class="vet-controls"><label>Search doctors<input id="vet-search" type="search" placeholder="Name, locality or field of care…" /></label><label>Care offered<select id="vet-focus"><option value="">All care</option><option value="surgery">Surgery</option><option value="medicine">Medicine</option><option value="preventive">Preventive care</option><option value="radiology">Radiology</option></select></label><label>Practice location<select id="vet-practice"><option value="">All profiles</option><option value="mapped">Linked clinic & map</option></select></label></div>
  <p class="small muted" id="vet-count" role="status">9 veterinarians · compare practices and care offered</p>
  <div class="vet-grid">{veterinarians.map(v=><div data-vet-row data-search={[v.name,...v.aliases,v.area,v.practice,...v.focus].join(' ').toLowerCase()} data-focus={v.focus.join(' ').toLowerCase()} data-mapped={String(v.providerIds.length>0)}><VetCard vet={v}/></div>)}</div>
  <p id="vet-empty" class="notice-box" hidden>No matching doctors. Try a surname or remove a filter.</p>
  <section class="vet-faq"><h2>Choose with a little more context</h2><details open><summary>Who are the top veterinarians in Indore?</summary><p>The right doctor depends on your pet’s condition, species, location and the care available. This is an alphabetical, researched directory, not a clinical quality ranking. Inclusion requires an identifiable public professional or practice source; nine profiles currently meet that publication threshold.</p></details><details><summary>How much is a consultation?</summary><p>Myra’s public listing indicates ₹200; confirm before visiting. Other fees may be unknown or conflicting. A practice’s listed consultation fee is separate from community-reported visit costs, diagnostics, procedures and medicines. <a href="/costs/">Read the cost guide</a>.</p></details><details><summary>Are qualifications, availability and reviews verified?</summary><p>Qualifications are attributed to their sources and are not a Vetlas credential check. Call the practice to confirm the doctor, schedule and suitability for your pet. Facility platform ratings are not ratings of an individual doctor. Sources and unresolved identity or practice details appear on each profile.</p></details></section>
 </div>
</BaseLayout>
<script>
 const search=document.querySelector<HTMLInputElement>('#vet-search')!,focus=document.querySelector<HTMLSelectElement>('#vet-focus')!,practice=document.querySelector<HTMLSelectElement>('#vet-practice')!;
 const rows=Array.from(document.querySelectorAll<HTMLElement>('[data-vet-row]'));
 const params=new URLSearchParams(location.search);search.value=params.get('q')||'';
 function filter(){let count=0;const q=search.value.toLowerCase().trim().split(/\s+/);rows.forEach(row=>{const match=q.every(term=>(row.dataset.search||'').includes(term))&&(!focus.value||(row.dataset.focus||'').includes(focus.value))&&(!practice.value||row.dataset.mapped==='true');row.hidden=!match;if(match)count++;});document.querySelector('#vet-count')!.textContent=`${count} of ${rows.length} profiles · alphabetical by name`;document.querySelector<HTMLElement>('#vet-empty')!.hidden=count>0;}
 [search,focus,practice].forEach(el=>el.addEventListener('input',filter));filter();
</script>
<style>.vets-page{padding-bottom:3rem}.vets-page header{padding:1.3rem 0}.vets-page h1{font-size:clamp(1.8rem,5vw,3rem);margin:.5rem 0}.vets-page header>p{max-width:760px}.vet-controls{display:grid;grid-template-columns:2fr 1fr 1fr;gap:.7rem;background:#e5f5ef;border:1px solid #d2ebe3;padding:1rem;border-radius:20px}.vet-controls label{font-size:.75rem;font-weight:600;display:grid;gap:.35rem}.vet-controls input,.vet-controls select{width:100%;min-width:0;min-height:44px;padding:.6rem;border:1px solid #c7e1d9;border-radius:10px;background:white;font:inherit}.vet-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.vet-faq{max-width:850px;margin:2rem auto}.vet-faq details{border-bottom:1px solid #d8e8e2;padding:1rem 0}.vet-faq summary{font-weight:600;cursor:pointer}.vet-faq p{font-size:.9rem;color:#50636d}@media(max-width:620px){.vet-grid{grid-template-columns:1fr}.vet-controls{grid-template-columns:1fr 1fr}.vet-controls label:first-child{grid-column:1/-1}}</style>
