---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FacilityCard from '../../../components/FacilityCard.astro';
import MapPreview from '../../../components/MapPreview.astro';
import { veterinarians } from '../../../data/veterinarians';
import { providers } from '@data';
export function getStaticPaths(){return veterinarians.map(vet=>({params:{slug:vet.slug},props:{vet}}));}
const {vet}=Astro.props;
const practices=providers.filter(p=>vet.providerIds.includes(p.id));
const path=`/indore/veterinarians/${vet.slug}/`;
const schema={'@context':'https://schema.org','@type':'Person','@id':new URL(path,Astro.site).href+'#person',name:`Dr. ${vet.name}`,alternateName:vet.aliases,url:new URL(path,Astro.site).href,jobTitle:'Veterinarian',description:vet.about,subjectOf:vet.sources.filter(s=>s.access!=='user-confirmed').map(s=>({'@type':'WebPage',url:s.url,name:s.label}))};
---
<BaseLayout title={`Dr. ${vet.name}, veterinarian in Indore — practice & fees | Vetlas`} description={`Find Dr. ${vet.name} in ${vet.area}, Indore. Read sourced practice details, published qualifications, consultation information and appointment guidance.`} canonical={path}>
 <script type="application/ld+json" set:html={JSON.stringify(schema)} />
 <div class="container vet-profile"><Breadcrumbs items={[{name:'Home',href:'/'},{name:'Indore',href:'/indore/'},{name:'Veterinarians',href:'/indore/veterinarians/'},{name:`Dr. ${vet.name}`,href:path}]}/>
 <header><p class="eyebrow">Veterinarian · Indore</p><h1>Dr. {vet.name}</h1><p>{vet.focus.join(' · ')}</p><p class="small muted">{vet.area} · Checked {vet.checkedAt}</p>{vet.aliases.length>0&&<p class="small">Also searchable as: {vet.aliases.join(', ')}. See identity notes below.</p>}
 <div class="list-inline">{practices[0]?.phone&&<a class="btn btn-primary" href={`tel:${practices[0].phone.replace(/[^+\d]/g,'')}`}>Call listed practice</a>}<a class="btn btn-secondary" href="#practice">Practice & consultation ↓</a><a class="btn btn-secondary" href="#evidence">Read sources ↓</a></div></header>
 <div class="vet-profile-grid"><section class="panel"><h2>About the doctor</h2><p>{vet.about}</p><h3>Published qualifications</h3>{vet.qualifications.length?<ul>{vet.qualifications.map(q=><li>{q}</li>)}</ul>:<p>Not confirmed from the available sources.</p>}<p class="small muted">Source-attributed information, not an independent credential or registration check.</p><h3>Before you book</h3><p>{vet.appointmentNote}</p><p>Ask whether the doctor treats your pet’s species and condition, what the consultation includes, and whether tests or procedures cost extra.</p></section>
 <aside class="panel"><h2>Practice details</h2><p><strong>{vet.practice}</strong></p><p>Appointment availability is confirmed directly by the practice.</p><a href="/indore/veterinarians/">Compare other Indore veterinarians →</a><p class="small muted">No doctor-specific rating is assigned. Public facility ratings describe the practice and cannot establish a clinician’s quality.</p><a href={`mailto:hello@thatvetguy.net?subject=${encodeURIComponent('Vetlas doctor correction: '+vet.name)}`}>Suggest a correction</a></aside></div>
 <section id="practice"><h2>Practice & consultation</h2>{practices.length?practices.map(p=><div class="practice-block"><FacilityCard provider={p}/><MapPreview providerId={p.id}/></div>):<p class="notice-box">Current appointment address, phone and consultation fee have not been confirmed. Follow the professional and directory sources below; confirm the consulting location before travelling.</p>}</section>
 <section id="evidence" class="panel"><h2>Sources & evidence</h2><p class="small">Checked {vet.checkedAt}. Some sources were accessible through their public search index; those are labelled below.</p><ul class="vet-sources">{vet.sources.map(s=><li><a href={s.url} target={s.url.startsWith('http')?'_blank':undefined} rel="noreferrer">{s.label} →</a><small>{s.access==='search-index'?'Public search-index observation':s.access==='user-confirmed'?'Requester confirmation; independent confirmation pending':'Public page'}</small></li>)}</ul></section>
 </div>
</BaseLayout>
<style>.vet-profile{padding-bottom:3rem}.vet-profile header{padding:1.5rem 0}.vet-profile h1{font-size:clamp(1.9rem,5vw,3rem);margin:.6rem 0}.vet-profile-grid{display:grid;grid-template-columns:2fr 1fr;gap:1rem;margin:1rem 0}.vet-profile .panel{padding:1.3rem;min-width:0}.vet-profile p{line-height:1.65}.vet-profile .list-inline{gap:.5rem;flex-wrap:wrap}.practice-block{max-width:800px;margin:1rem 0 2rem}.vet-sources{padding-left:1.2rem}.vet-sources li{margin:1rem 0;overflow-wrap:anywhere}.vet-sources small{display:block;color:#586b73}@media(max-width:650px){.vet-profile-grid{grid-template-columns:1fr}}</style>
