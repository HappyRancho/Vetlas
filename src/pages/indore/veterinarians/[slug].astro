---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VetPortrait from '../../../components/VetPortrait.astro';
import FacilityCard from '../../../components/FacilityCard.astro';
import MapPreview from '../../../components/MapPreview.astro';
import { veterinarians } from '../../../data/veterinarians';
import { providers } from '@data';
export function getStaticPaths(){return veterinarians.map(vet=>({params:{slug:vet.slug},props:{vet}}));}
const {vet}=Astro.props;
const practices=providers.filter(p=>vet.providerIds.includes(p.id));
const path=`/indore/veterinarians/${vet.slug}/`;
const schema={'@context':'https://schema.org','@type':'Person','@id':new URL(path,Astro.site).href+'#person',name:`Dr. ${vet.name}`,alternateName:vet.aliases,url:new URL(path,Astro.site).href,jobTitle:'Veterinarian',workLocation:practices.map(p=>({'@id':new URL('/indore/'+p.slug+'/#facility',Astro.site).href})),image:vet.imageUrl?new URL(vet.imageUrl,Astro.site).href:undefined,description:vet.about,subjectOf:vet.sources.filter(s=>s.access!=='user-confirmed').map(s=>({'@type':'WebPage',url:s.url,name:s.label}))};
---
<BaseLayout title={`Dr. ${vet.name}, veterinarian in Indore — practice & fees | Vetlas`} description={`Find Dr. ${vet.name} in ${vet.area}, Indore. Read sourced practice details, published qualifications, consultation information and appointment guidance.`} canonical={path}>
 <script type="application/ld+json" set:html={JSON.stringify(schema)} />
 <div class="container vet-profile"><Breadcrumbs items={[{name:'Home',href:'/'},{name:'Indore',href:'/indore/'},{name:'Veterinarians',href:'/indore/veterinarians/'},{name:`Dr. ${vet.name}`,href:path}]}/>
 <header><div class="doctor-profile-heading"><VetPortrait vet={vet} large/><div><p class="eyebrow">Veterinarian · Indore</p><h1>Dr. {vet.name}</h1><p>{vet.focus.join(' · ')}</p><p class="small muted">{vet.area}</p>{vet.aliases.length>0&&<p class="small">Also searchable as: {vet.aliases.join(', ')}.</p>}
 </div></div><div class="list-inline">{practices[0]?.phone&&<a class="btn btn-primary" href={`tel:${practices[0].phone.replace(/[^+\d]/g,'')}`}>Call practice</a>}<a class="btn btn-secondary" href="#practice">Practice & consultation ↓</a></div></header>
 <div class="vet-profile-grid"><section class="panel"><h2>About the doctor</h2><p>{vet.about}</p>{vet.qualifications.length>0&&<><h3>Qualifications</h3><ul>{vet.qualifications.map(q=><li>{q}</li>)}</ul></>}<h3>Before you book</h3><p>{vet.appointmentNote}</p></section>
 <aside class="panel"><h2>Practice details</h2><p><strong>{vet.practice}</strong></p><p>Appointment availability is confirmed directly by the practice.</p><a href="/indore/veterinarians/">Compare other Indore veterinarians →</a><a href={`mailto:hello@thatvetguy.net?subject=${encodeURIComponent('Vetlas doctor correction: '+vet.name)}`}>Suggest a correction</a></aside></div>
 <section id="practice"><h2>Practice & consultation</h2>{practices.length?practices.map(p=><div class="practice-block"><FacilityCard provider={p}/><MapPreview providerId={p.id}/></div>):<p class="notice-box">Current appointment address, phone and consultation fee have not been confirmed. Follow the professional and directory sources below; confirm the consulting location before travelling.</p>}</section>
 <details id="evidence" class="panel doctor-evidence"><summary>Profile details & photo credits</summary><p class="small">Checked {vet.checkedAt}. Some sources were accessible through their public search index; those are labelled below.</p><ul class="vet-sources">{vet.sources.map(s=><li><a href={s.url} target={s.url.startsWith('http')?'_blank':undefined} rel="noreferrer">{s.label} →</a><small>{s.access==='search-index'?'Public search-index observation':s.access==='user-confirmed'?'Requester confirmation; independent confirmation pending':'Public page'}</small></li>)}</ul>{vet.imageSourceUrl&&<p class="small">Photo: <a href={vet.imageSourceUrl} target="_blank" rel="noreferrer">{vet.imageCredit}</a></p>}<p class="small">Published qualifications are attributed to the linked sources.</p></details>
 </div>
</BaseLayout>
<style>.vet-profile{padding-bottom:3rem}.vet-profile header{padding:1.5rem 0}.vet-profile h1{font-size:clamp(1.9rem,5vw,3rem);margin:.6rem 0}.vet-profile-grid{display:grid;grid-template-columns:2fr 1fr;gap:1rem;margin:1rem 0}.vet-profile .panel{padding:1.3rem;min-width:0}.vet-profile p{line-height:1.65}.vet-profile .list-inline{gap:.5rem;flex-wrap:wrap}.practice-block{max-width:800px;margin:1rem 0 2rem}.vet-sources{padding-left:1.2rem}.vet-sources li{margin:1rem 0;overflow-wrap:anywhere}.vet-sources small{display:block;color:#586b73}@media(max-width:650px){.vet-profile-grid{grid-template-columns:1fr}}</style>

<style>.doctor-profile-heading{display:flex;align-items:center;gap:16px;margin-bottom:16px}.doctor-profile-heading h1{font-size:clamp(24px,4vw,36px)}.doctor-profile-heading p{font-size:12px;line-height:1.5}.doctor-evidence summary{cursor:pointer;color:#52716a;font-size:13px;font-weight:600}.vet-profile .panel p{font-size:13px}.vet-profile .panel h2{font-size:21px}.vet-profile .panel h3{font-size:16px}.vet-profile .list-inline .btn{font-size:12px;padding:10px 14px}@media(max-width:440px){.doctor-profile-heading :global(.vet-portrait-large){width:90px;height:105px}.doctor-profile-heading h1{font-size:24px}.doctor-profile-heading{gap:12px}}</style>
