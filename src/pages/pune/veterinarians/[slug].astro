---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { doctorsByCity, doctorsProviders, specialtyById } from "@data";
const allDoctors = doctorsByCity("pune");
export function getStaticPaths() {
  return allDoctors.map(doctor=>({params:{slug:doctor.slug},props:{doctor}}));
}
const {doctor} = Astro.props;
const practices = doctorsProviders(doctor);
const specialty = specialtyById(doctor.primarySpecialtyId);
const url = `/pune/veterinarians/${doctor.slug}/`;
---
<BaseLayout title={`Dr. ${doctor.name} — Pune veterinarian | Vetlas`} description={`Public-source profile for Dr. ${doctor.name} in Pune or Pimpri-Chinchwad. Check reported practice affiliations, areas of care and research limitations.`} canonical={url} noindex>
  <div class="container vet-profile">
    <Breadcrumbs items={[{name:"Home",href:"/"},{name:"Pune",href:"/pune/"},{name:"Veterinarians",href:"/pune/veterinarians/"},{name:`Dr. ${doctor.name}`,href:url}]}/>
    <header class="page-head"><p class="eyebrow">Public-source professional profile · not independently credential-verified</p><h1>Dr. {doctor.name}</h1><p>{specialty?.name || "Veterinary care"} · Pune / Pimpri-Chinchwad</p></header>
    <section class="panel"><h2>Publicly documented care</h2><p>{doctor.about}</p>{doctor.degrees.length>0&&<p><strong>Reported qualifications:</strong> {doctor.degrees.join(" · ")} — source-claimed, not independently checked by Vetlas.</p>}
      {doctor.species.length>0&&<p><strong>Species:</strong> {doctor.species.join(", ")}</p>}
      {typeof doctor.consultationFee==="number"&&<p><strong>Published consultation fee:</strong> ₹{doctor.consultationFee} (confirm directly)</p>}
      {practices.length>0&&<><h2>Associated practices</h2><ul>{practices.map(p=><li><a href={`/pune/${p.slug}/`}>{p.name}</a> — {p.area}, Pune</li>)}</ul></>}
      <h2>Research evidence and limitations</h2><p>{doctor.evidence || "Independent verification pending."}</p><p>Research confidence: {doctor.confidence || "not assessed"} (source coverage, not medical quality). Public-source research dated November 16, 2026. Call the practice to confirm current credentials, address, availability and fees.</p>
      <a href="/methodology/">How Vetlas evaluates evidence</a>
    </section>
  </div>
</BaseLayout>
