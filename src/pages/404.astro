---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  title="Page not found — Vetlas"
  description="This page wandered off. Search for veterinary care across India instead."
  noindex={true}
>
  <div class="container" style="min-height:50vh;display:flex;align-items:center;justify-content:center">
    <div class="empty-state" style="margin:3rem auto">
      <span class="icon-wrap animate-wiggle"><Icon name="paw" class="icon icon-xl" /></span>
      <h1 style="font-size:1.8rem">This page wandered off</h1>
      <p>Even the best-trained pages sometimes don't come when called. Let's get you back on track.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Go home</a>
        <a class="btn btn-secondary" href="/search/">Search for care</a>
      </div>
    </div>
  </div>
</BaseLayout>
