---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import SearchBuilder from "../components/SearchBuilder.astro";
import ProviderLedgerRow from "../components/ProviderLedgerRow.astro";
import DoctorLedgerRow from "../components/DoctorLedgerRow.astro";
import TrustBadge from "../components/TrustBadge.astro";
import {
  cities, specialties, providers, doctors, reviews, costEstimates,
  providersByCity, feeRangeINR, deriveReviewThemes,
} from "@data";

const topProviders = [...providers].sort((a, b) => b.rating - a.rating).slice(0, 5);
const topDoctors = [...doctors].sort((a, b) => b.rating - a.rating).slice(0, 5);

/** Top recurring theme per provider (spec: themes over stars) */
const themeFor = (slug: string) => deriveReviewThemes(reviews.filter((r) => r.targetSlug === slug))[0]?.theme;

/**
 * Invisible filler cells for the hairline grid: a multiple of 6 keeps the
 * last row full at every column count we use (1 / 2 / 3). Hidden on mobile.
 */
const gridFill = (6 - (specialties.length % 6)) % 6;
---

<BaseLayout
  title="Vetlas — Choose veterinary care in India with confidence"
  description="A decision-support tool for pet owners in India: find veterinary clinics, hospitals and doctors with attributed, trustworthy data. No ads, no paid placements."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <p class="eyebrow animate-fade-in">
          <Icon name="sparkle" class="icon icon-md icon-amber" />
          Made for India's pets &amp; their people
        </p>
        <h1 class="hero-title">
          Find the right care<br />
          for the one who <span class="accent">can't tell<svg viewBox="0 0 220 12" fill="none" preserveAspectRatio="none" aria-hidden="true"><path d="M3 9c50-6 150-6 214-2" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg></span>
          you where it hurts
        </h1>
        <p class="hero-sub">
          Vetlas is a decision-support tool, not a directory or ad platform. Every fact carries a
          trust label and a source — so you can choose care with confidence.
        </p>
        <div class="hero-search">
          <SearchBuilder />
        </div>
        <ul class="hero-chips">
          {specialties.slice(0, 5).map((s) => (
            <li>
              <a class="chip" href={`/specialties/${s.slug}/`}>
                <Icon name={s.icon} class="icon icon-sm" />
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <dl class="stat-row">
        <div class="stat"><dt>{specialties.length}</dt><dd>Specialities covered</dd></div>
        <div class="stat"><dt>{cities.length}</dt><dd>Cities &amp; growing</dd></div>
        <div class="stat"><dt>{providers.length + doctors.length}</dt><dd>Sample listings</dd></div>
        <div class="stat"><dt>₹0</dt><dd>Always free to use</dd></div>
      </dl>
    </div>
  </section>

  <!-- Specialties — hairline directory -->
  <section class="section container" aria-labelledby="specialties-h">
    <div class="section-head">
      <div>
        <h2 class="section-title" id="specialties-h">Browse by speciality</h2>
        <p>From everyday checkups to 24×7 critical care.</p>
      </div>
      <a class="link-more" href="/specialties/">All specialties <Icon name="arrow" class="icon" /></a>
    </div>
    <ul class="hairline-grid">
      {specialties.map((s) => (
        <li>
          <a class="dir-cell" href={`/specialties/${s.slug}/`}>
            <span class="dir-icon"><Icon name={s.icon} class="icon icon-lg" /></span>
            <span class="dir-text">
              <b>{s.name}</b>
              <span>{s.tagline}</span>
            </span>
            <Icon name="arrow" class="icon dir-arrow" />
          </a>
        </li>
      ))}
      {Array.from({ length: gridFill }).map(() => (
        <li class="dir-fill" aria-hidden="true" />
      ))}
    </ul>
  </section>

  <!-- Top care — ledger -->
  <section class="section container" aria-labelledby="clinics-h">
    <div class="section-head">
      <div>
        <h2 class="section-title" id="clinics-h">Care people rely on</h2>
        <p>Sample listings from our beta dataset — each row shows a recurring reviewer theme.</p>
      </div>
      <a class="link-more" href="/search/">Explore all listings <Icon name="arrow" class="icon" /></a>
    </div>
    <ol class="ledger">
      {topProviders.map((p, i) => (
        <ProviderLedgerRow provider={p} index={i} theme={themeFor(p.slug)} />
      ))}
    </ol>
  </section>

  <!-- Doctors -->
  <section class="section-band">
    <div class="section container">
      <div class="section-head">
        <div>
          <h2 class="section-title">Meet the doctors</h2>
          <p>Specialists, surgeons and gentle first-opinion vets.</p>
        </div>
        <a class="link-more" href="/search/">Find a doctor <Icon name="arrow" class="icon" /></a>
      </div>
      <ol class="ledger">
        {topDoctors.map((d, i) => (
          <DoctorLedgerRow doctor={d} index={i} theme={themeFor(d.slug)} />
        ))}
      </ol>
    </div>
  </section>

  <!-- Cities — index rows -->
  <section class="section container" aria-labelledby="cities-h">
    <div class="section-head">
      <div>
        <h2 class="section-title" id="cities-h">Veterinary care across India</h2>
        <p>Published city by city — only when quality thresholds are met.</p>
      </div>
      <a class="link-more" href="/locations/">All locations <Icon name="arrow" class="icon" /></a>
    </div>
    <ul class="index-list">
      {cities.map((c) => {
        const n = providersByCity(c.id).length;
        return (
          <li>
            <a class="index-row" href={`/${c.slug}/`}>
              <span class="index-name">{c.name}</span>
              <span class="index-meta">{c.state}</span>
              <span class="index-count">{n} {n === 1 ? "listing" : "listings"}</span>
              <Icon name="arrow" class="icon index-arrow" />
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- Cost guide -->
  <section class="section section-band" aria-labelledby="costs-h">
    <div class="container split">
      <div class="split-lead">
        <p class="eyebrow"><Icon name="wallet" class="icon icon-md" /> Budget with confidence</p>
        <h2 class="section-title" id="costs-h">Know typical costs before you go</h2>
        <p class="soft">
          Indicative ranges for consultations, vaccinations, diagnostics and procedures — kept
          strictly separate from provider fees, and labelled honestly.
        </p>
        <a class="btn btn-primary" href="/costs/">
          View the full cost guide <Icon name="arrow" class="icon icon-md" />
        </a>
      </div>
      <ul class="cost-rows">
        {costEstimates.slice(2, 8).map((c) => (
          <li>
            <span class="cost-label">{c.name}</span>
            <b class="cost-value">{feeRangeINR(c.min, c.max)}</b>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Trust -->
  <section class="section container" aria-labelledby="trust-h">
    <h2 class="section-title" id="trust-h">Why trust Vetlas</h2>
    <ul class="feature-row">
      <li class="feature">
        <span class="card-icon"><Icon name="badge" class="icon icon-lg" /></span>
        <h3>Honest data, clearly labelled</h3>
        <p class="small soft">Every fact carries a trust label with a distinct shape and colour — readable without colour vision.</p>
        <p class="feature-badges"><TrustBadge level="verified" /> <TrustBadge level="provider-confirmed" /> <TrustBadge level="public" /></p>
      </li>
      <li class="feature">
        <span class="card-icon amber"><Icon name="shield" class="icon icon-lg" /></span>
        <h3>No ads, no paid placement</h3>
        <p class="small soft">Providers can never pay for higher rankings or to hide reviews. Rankings follow data, not money.</p>
      </li>
      <li class="feature">
        <span class="card-icon coral"><Icon name="sparkle" class="icon icon-lg" /></span>
        <h3>Themes over stars</h3>
        <p class="small soft">Reputation is shown through recurring reviewer themes — like “Calm with nervous pets” — not just aggregate numbers.</p>
      </li>
    </ul>
  </section>
</BaseLayout>
