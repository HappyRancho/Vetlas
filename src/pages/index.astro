---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import UniversalSearch from "../components/UniversalSearch.astro";
import LocationPicker from "../components/LocationPicker.astro";
import FacilityCard from "../components/FacilityCard.astro";
import DoctorCard from "../components/DoctorCard.astro";
import TrustBadge from "../components/TrustBadge.astro";
import {
  cities, specialties, providers, doctors, reviews,
  feeINR, deriveReviewThemes,
} from "@data";

const hospitalCount = providers.filter((p) => p.type === "hospital").length;
const clinicCount = providers.filter((p) => p.type === "clinic").length;

const featured = [...providers]
  .sort((a, b) => b.rating - a.rating || b.reviewCount - a.reviewCount)
  .slice(0, 4);

const topDoctors = [...doctors]
  .sort((a, b) => b.rating - a.rating || b.reviewCount - a.reviewCount)
  .slice(0, 4);

const popular = [...providers]
  .sort((a, b) => b.reviewCount - a.reviewCount)
  .slice(0, 5);

const comparison = [providers[0], providers[1], providers[2]].filter(Boolean);
const openNow = providers.filter((p) => p.hours.open24).slice(0, 3);

const themeFor = (slug: string) =>
  deriveReviewThemes(reviews.filter((r) => r.targetSlug === slug))[0]?.theme;

const discovery = [
  {
    label: "Hospitals",
    href: "/search/?type=hospital",
    icon: "building",
    countText: `${hospitalCount} sample hospitals`,
    text: "Emergency, surgery & inpatient care",
    tone: "sky",
  },
  {
    label: "Clinics",
    href: "/search/?type=clinic",
    icon: "heart",
    countText: `${clinicCount} sample clinics`,
    text: "Neighbourhood consults & preventive care",
    tone: "mint",
  },
  {
    label: "Doctors",
    href: "/search/?type=doctor",
    icon: "doctor",
    countText: `${doctors.length} sample doctors`,
    text: "Individual vets and their specialisms",
    tone: "lilac",
  },
  {
    label: "Specialist care",
    href: "/specialties/",
    icon: "stethoscope",
    countText: `${specialties.length} specialities`,
    text: "From dentistry to emergency medicine",
    tone: "sand",
  },
];
---

<BaseLayout
  title="Vetlas — find veterinary care in India, calmly"
  description="Discover veterinary hospitals, clinics and doctors across India. Compare locations, specialities, facilities, fees and sample ratings — with every fact clearly labelled."
>
  <section class="home-hero">
    <div class="container hero-layout">
      <div class="hero-copy">
        <div class="hero-kicker-row">
          <p class="eyebrow"><Icon name="sparkle" class="icon icon-md" /> Veterinary care across India</p>
          <LocationPicker />
        </div>

        <h1 class="home-title">
          Find the right vet,<br />
          <span class="title-accent">without the guesswork.</span>
        </h1>
        <p class="home-sub">
          Search hospitals, clinics and doctors by city or speciality. See the details that matter
          before you go — facilities, consultation fees and what other pet owners mention.
        </p>

        <UniversalSearch variant="hero" />

        <div class="hero-quick">
          <span class="hero-quick-label">Popular</span>
          <a href="/search/?q=Emergency">Emergency care</a>
          <a href="/specialties/dermatology/">Dermatology</a>
          <a href="/search/?q=Dentistry">Dentistry</a>
          <a href="/search/?q=Bengaluru">Bengaluru</a>
        </div>
      </div>

      <aside class="hero-aside" aria-labelledby="open-now-h">
        <div class="aside-head">
          <div>
            <p class="aside-eyebrow">For the urgent moments</p>
            <h2 id="open-now-h">Open 24×7</h2>
          </div>
          <TrustBadge level="sample" label="Sample" />
        </div>
        <ul class="open-list">
          {openNow.map((p) => (
            <li>
              <span class="open-icon"><Icon name="siren" class="icon icon-md" /></span>
              <span class="open-text">
                <a href={`/${cities.find((c) => c.id === p.cityId)?.slug}/${p.slug}/`}>{p.name}</a>
                <span>{p.area}, {cities.find((c) => c.id === p.cityId)?.name}</span>
              </span>
              <Icon name="arrow" class="icon open-arrow" />
            </li>
          ))}
        </ul>
        <a class="aside-link" href="/search/?q=24">Browse emergency care <Icon name="arrow" class="icon" /></a>
      </aside>
    </div>

    <div class="container">
      <dl class="hero-stats">
        <div><dt>{providers.length}</dt><dd>sample facilities</dd></div>
        <div><dt>{doctors.length}</dt><dd>sample doctors</dd></div>
        <div><dt>{cities.length}</dt><dd>cities mapped</dd></div>
        <div><dt>{specialties.length}</dt><dd>specialities</dd></div>
      </dl>
    </div>
  </section>

  <section class="section container" aria-labelledby="discover-h">
    <div class="section-head">
      <div>
        <p class="section-eyebrow">Start here</p>
        <h2 class="section-title" id="discover-h">What are you looking for?</h2>
      </div>
      <a class="link-more" href="/search/">See all care <Icon name="arrow" class="icon" /></a>
    </div>
    <ul class="discovery-grid">
      {discovery.map((item) => (
        <li>
          <a class={`discovery-card discovery-${item.tone}`} href={item.href}>
            <span class="discovery-icon"><Icon name={item.icon} class="icon icon-lg" /></span>
            <span class="discovery-copy">
              <span class="discovery-count">{item.countText}</span>
              <b>{item.label}</b>
              <span>{item.text}</span>
            </span>
            <span class="discovery-arrow" aria-hidden="true"><Icon name="arrow" class="icon" /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section section-tint" aria-labelledby="featured-h">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-eyebrow">Care people choose</p>
          <h2 class="section-title" id="featured-h">Featured hospitals &amp; clinics</h2>
          <p>Sample facilities, ranked by illustrative rating — never by payment.</p>
        </div>
        <a class="link-more" href="/search/">Explore all listings <Icon name="arrow" class="icon" /></a>
      </div>
      <div class="facility-grid">
        {featured.map((p, i) => <FacilityCard provider={p} index={i} featured />)}
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="specialities-h">
    <div class="section-head">
      <div>
        <p class="section-eyebrow">Find the right expertise</p>
        <h2 class="section-title" id="specialities-h">Browse by speciality</h2>
        <p>Know what your pet needs? Start with the speciality, then choose a city.</p>
      </div>
      <a class="link-more" href="/specialties/">All {specialties.length} specialities <Icon name="arrow" class="icon" /></a>
    </div>
    <ul class="specialty-grid">
      {specialties.slice(0, 12).map((s) => (
        <li>
          <a class="specialty-card" href={`/specialties/${s.slug}/`}>
            <span class="specialty-icon"><Icon name={s.icon} class="icon icon-md" /></span>
            <span class="specialty-copy">
              <b>{s.name}</b>
              <span>{s.tagline}</span>
            </span>
            <Icon name="arrow" class="icon specialty-arrow" />
          </a>
        </li>
      ))}
    </ul>
    <p class="specialty-more">
      <a href="/specialties/">View every veterinary speciality <Icon name="arrow" class="icon" /></a>
    </p>
  </section>

  <section class="section section-tint" aria-labelledby="doctors-h">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-eyebrow">People behind the care</p>
          <h2 class="section-title" id="doctors-h">Featured veterinary doctors</h2>
          <p>Qualifications, experience and the practice they work with — all clearly labelled.</p>
        </div>
        <a class="link-more" href="/search/?type=doctor">Meet more doctors <Icon name="arrow" class="icon" /></a>
      </div>
      <div class="doctor-grid">
        {topDoctors.map((d, i) => <DoctorCard doctor={d} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="popular-h">
    <div class="section-head">
      <div>
        <p class="section-eyebrow">Most reviewed in the sample set</p>
        <h2 class="section-title" id="popular-h">Popular hospitals &amp; clinics</h2>
      </div>
      <a class="link-more" href="/locations/">Browse by city <Icon name="arrow" class="icon" /></a>
    </div>
    <ol class="popular-list">
      {popular.map((p, i) => {
        const city = cities.find((c) => c.id === p.cityId);
        return (
          <li>
            <a class="popular-row" href={`/${city?.slug}/${p.slug}/`}>
              <span class="popular-rank">{String(i + 1).padStart(2, "0")}</span>
              <span class="popular-icon"><Icon name={p.type === "hospital" ? "building" : "heart"} class="icon icon-md" /></span>
              <span class="popular-name">
                <b>{p.name}</b>
                <span>{p.area}, {city?.name} · {p.type === "hospital" ? "Hospital" : "Clinic"}</span>
              </span>
              <span class="popular-open">{p.hours.open24 ? "24×7" : `${p.hours.open}–${p.hours.close}`}</span>
              <span class="popular-rating">★ {p.rating.toFixed(1)} <small>{p.reviewCount} sample reviews</small></span>
              <span class="popular-fee">{feeINR(p.fees.opd)}<small>consult</small></span>
              <Icon name="arrow" class="icon popular-arrow" />
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="section section-tint" aria-labelledby="compare-h">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="section-eyebrow">The details that matter</p>
          <h2 class="section-title" id="compare-h">Compare before you choose</h2>
          <p>Fees, opening hours, facilities and reviewer themes — side by side.</p>
        </div>
        <TrustBadge level="sample" label="Sample data" />
      </div>
      <div class="compare-grid">
        {comparison.map((p) => {
          const city = cities.find((c) => c.id === p.cityId);
          const theme = themeFor(p.slug);
          return (
            <article class="compare-card">
              <div class="compare-head">
                <span class="compare-type"><Icon name={p.type === "hospital" ? "building" : "heart"} class="icon" />{p.type === "hospital" ? "Hospital" : "Clinic"}</span>
                <span class="compare-rating">★ {p.rating.toFixed(1)}</span>
              </div>
              <h3><a href={`/${city?.slug}/${p.slug}/`}>{p.name}</a></h3>
              <p class="compare-loc">{p.area}, {city?.name}</p>
              <dl class="compare-rows">
                <div><dt>Consultation</dt><dd>{feeINR(p.fees.opd)}</dd></div>
                <div><dt>Hours</dt><dd>{p.hours.open24 ? "Open 24×7" : `${p.hours.open}–${p.hours.close}`}</dd></div>
                <div><dt>Facilities</dt><dd>{p.amenities.slice(0, 2).join(" · ")}</dd></div>
                <div><dt>Reviewers say</dt><dd class="compare-theme">{theme ? `“${theme}”` : "Not enough sample reviews"}</dd></div>
              </dl>
              <a class="btn btn-secondary compare-btn" href={`/${city?.slug}/${p.slug}/`}>View profile</a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="how-h">
    <div class="section-head">
      <div>
        <p class="section-eyebrow">A calmer directory</p>
        <h2 class="section-title" id="how-h">Why people use Vetlas</h2>
      </div>
    </div>
    <ul class="value-row">
      <li>
        <span class="value-icon"><Icon name="badge" class="icon icon-lg" /></span>
        <h3>Clearly labelled data</h3>
        <p>Every fee, rating and profile carries its trust status. Sample content is never dressed up as verified.</p>
      </li>
      <li>
        <span class="value-icon value-mint"><Icon name="shield" class="icon icon-lg" /></span>
        <h3>No ads or paid rankings</h3>
        <p>Hospitals and clinics cannot buy a higher position. Ordering follows the data, not the cheque book.</p>
      </li>
      <li>
        <span class="value-icon value-sand"><Icon name="sparkle" class="icon icon-lg" /></span>
        <h3>Reviews with context</h3>
        <p>Recurring themes — such as calm handling or clear explanations — sit alongside ratings, not instead of them.</p>
      </li>
    </ul>
  </section>
</BaseLayout>
