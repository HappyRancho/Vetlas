---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import UniversalSearch from "../components/UniversalSearch.astro";
import { cities, providers, doctors, specialties, feeINR, cityById, specialtyById } from "@data";

interface RankRow {
  name: string;
  initials: string;
  tag: string;
  citySlug: string;
  href: string;
  fee: number;
  reviews: number;
}

const initialsOf = (name: string) =>
  name
    .replace(/^Dr\.?\s+/i, "")
    .split(/\s+/)
    .map((w) => w[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();

const ranked: RankRow[] = [
  ...providers.map((p) => {
    const city = cityById(p.cityId);
    return {
      name: p.name,
      initials: initialsOf(p.name),
      tag: p.type === "hospital" ? "Hospital" : "Clinic",
      citySlug: city?.slug ?? "",
      href: `/${city?.slug}/${p.slug}/`,
      fee: p.fees.opd,
      reviews: p.reviewCount,
    };
  }),
  ...doctors.map((d) => {
    const city = cityById(d.cityId);
    return {
      name: `Dr. ${d.name}`,
      initials: initialsOf(d.name),
      tag: specialtyById(d.primarySpecialtyId)?.name ?? "Veterinarian",
      citySlug: city?.slug ?? "",
      href: `/${city?.slug}/${d.slug}/`,
      fee: d.consultationFee,
      reviews: d.reviewCount,
    };
  }),
].sort((a, b) => b.reviews - a.reviews);

const maxReviews = ranked[0]?.reviews ?? 1;
const chipCities = cities.slice(0, 6);
const feesSorted = providers.map((p) => p.fees.opd).sort((a, b) => a - b);
const feeLow = feesSorted[0];
const feeHigh = feesSorted[feesSorted.length - 1];
---

<BaseLayout
  title="Vetlas — find veterinary care in India, calmly"
  description="Discover veterinary hospitals, clinics and doctors across India. Compare locations, specialities, facilities, fees and sample ratings — with every fact clearly labelled."
>
  <section class="dash container" aria-label="Find veterinary care">
    <p class="value-pill">
      <Icon name="paw" class="icon icon-md" />
      Choose a vet with evidence, not ads.
    </p>

    <UniversalSearch variant="hero" />

    <div class="city-chips" role="group" aria-label="Filter results by city">
      <button type="button" class="city-chip" data-city="" data-name="India" aria-pressed="true">
        <Icon name="pin" class="icon icon-sm" /> All India
      </button>
      {chipCities.map((c) => (
        <button type="button" class="city-chip" data-city={c.slug} data-name={c.name} aria-pressed="false">
          <Icon name="pin" class="icon icon-sm" /> {c.name}
        </button>
      ))}
      <a class="city-chip-more" href="/locations/">
        All {cities.length} cities <Icon name="arrow" class="icon icon-sm" />
      </a>
    </div>

    <article class="sos-card">
      <div class="sos-copy">
        <p class="sos-eyebrow">Need care now?</p>
        <h2>24×7 vets in <span id="sos-city">India</span></h2>
        <p class="sos-sub">Emergency first, then everything else.</p>
      </div>
      <a class="sos-btn" id="sos-link" href="/search/?q=24x7">Show now</a>
      <svg class="sos-ecg" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 14h84l8-9 10 18 10-9h52l8-9 10 18 10-9h52l8-9 10 18 10-9h124" />
      </svg>
    </article>

    <div class="duo-grid">
      <a class="duo-card duo-specialist" href="/specialties/">
        <h2>Find a<br />specialist</h2>
        <span class="duo-icons">
          <span class="duo-icon"><Icon name="tooth" class="icon icon-md" /></span>
          <span class="duo-icon"><Icon name="heart" class="icon icon-md" /></span>
          <span class="duo-icon"><Icon name="eye" class="icon icon-md" /></span>
          <span class="duo-icon duo-icon-more">+{Math.max(specialties.length - 3, 0)}</span>
        </span>
        <span class="duo-foot">
          {specialties.length} areas of care
          <span class="duo-arrow"><Icon name="arrow" class="icon icon-sm" /></span>
        </span>
      </a>

      <a class="duo-card duo-cost" href="/costs/">
        <h2>What will<br />it cost?</h2>
        <span class="duo-cost-label">Consult fee, typical · sample</span>
        <span class="duo-fee">₹{feeLow} – ₹{feeHigh}</span>
        <span class="duo-foot">
          Visit extras kept apart
          <span class="duo-arrow"><Icon name="arrow" class="icon icon-sm" /></span>
        </span>
      </a>
    </div>

    <a class="strip" href="/methodology/">
      <span class="strip-icon"><Icon name="sparkle" class="icon icon-md" /></span>
      <span class="strip-text">
        How the sample fees &amp; reviews are built
        <small>Every number carries its trust label</small>
      </span>
      <span class="strip-chip">1 min</span>
    </a>

    <section class="rank-card" aria-labelledby="rank-h">
      <div class="rank-head">
        <h2 id="rank-h">Top by owner reviews</h2>
        <a href="/search/">See all</a>
      </div>
      <p class="rank-sub">
        <span id="rank-city">India</span> · ranked by review count only, never by payment · sample
      </p>
      <div class="rank-list">
        {ranked.map((r) => (
          <a class="rank-row" href={r.href} data-city={r.citySlug}>
            <span class="rank-avatar" aria-hidden="true">{r.initials}</span>
            <span class="rank-main">
              <span class="rank-name">
                <b>{r.name}</b>
                <span class="rank-tag">{r.tag}</span>
              </span>
              <span class="rank-meter">
                <span class="rank-bar" aria-hidden="true">
                  <span class="rank-fill" style={`--w: ${Math.round((r.reviews / maxReviews) * 100)}%`} />
                </span>
                <span class="rank-count">{r.reviews}</span>
              </span>
            </span>
            <span class="rank-side">
              <span class="rank-fee">{feeINR(r.fee)}</span>
              <Icon name="arrow" class="icon rank-arrow" />
            </span>
          </a>
        ))}
      </div>
    </section>

    <a class="dash-all" href="/search/">
      Browse all {ranked.length} sample hospitals, clinics &amp; doctors
      <Icon name="arrow" class="icon icon-sm" />
    </a>
  </section>

  <script>
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".city-chip"));
    const rows = Array.from(document.querySelectorAll<HTMLAnchorElement>(".rank-row"));
    const sosCity = document.getElementById("sos-city");
    const sosLink = document.getElementById("sos-link") as HTMLAnchorElement | null;
    const rankCity = document.getElementById("rank-city");
    const KEY = "vetlas-city";

    function apply(citySlug: string, cityName: string) {
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.city === citySlug)));
      rows.forEach((r) => {
        r.hidden = citySlug !== "" && r.dataset.city !== citySlug;
      });
      if (rankCity) rankCity.textContent = cityName;
      if (sosCity) sosCity.textContent = cityName;
      if (sosLink) {
        sosLink.href = citySlug
          ? `/search/?q=${encodeURIComponent(`24x7 ${cityName}`)}`
          : "/search/?q=24x7";
      }
      try {
        localStorage.setItem(KEY, citySlug);
      } catch {
        /* storage unavailable */
      }
    }

    chips.forEach((c) => {
      c.addEventListener("click", () => apply(c.dataset.city ?? "", c.dataset.name ?? "India"));
    });

    try {
      const saved = localStorage.getItem(KEY);
      const chip = saved ? chips.find((c) => c.dataset.city === saved) : undefined;
      if (saved && chip) apply(saved, chip.dataset.name ?? "India");
    } catch {
      /* storage unavailable */
    }
  </script>
</BaseLayout>
