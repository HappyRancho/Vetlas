---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import UniversalSearch from "../components/UniversalSearch.astro";
import FacilityVisual from "../components/FacilityVisual.astro";
import { providers, cityById } from "@data";

const featured = providers.slice(0, 3);
const petTypes = [
  { label: "Dogs", emoji: "🐶", query: "dog" },
  { label: "Cats", emoji: "🐱", query: "cat" },
  { label: "Small Pets", emoji: "🐰", query: "rabbit" },
  { label: "Birds", emoji: "🦜", query: "bird" },
];
---

<BaseLayout
  title="Vetlas — find veterinary care in India, calmly"
  description="Discover veterinary hospitals, clinics and doctors across India. Compare locations, specialities, facilities, fees and sample ratings — with every fact clearly labelled."
>
  <section class="home-shell" aria-label="Find veterinary care">
    <div class="home-hero">
      <div class="hero-brand">
        <span class="hero-logo"><Icon name="paw" class="icon icon-lg" /><b>+</b></span>
        <span><strong>Vetlas</strong><small>by ThatVetGuy</small></span>
      </div>
      <div class="hero-actions">
        <a class="location-pill" href="/indore/"><Icon name="pin" class="icon icon-sm" /> Indore <span>⌄</span></a>
        <button class="notification-pill" type="button" aria-label="Notifications"><Icon name="bell" class="icon icon-md" /><i></i></button>
      </div>
      <div class="hero-copy">
        <h1>Find the Best<br /><em>Veterinary Care</em><br />for Your Pet</h1>
        <p>Hospitals · Clinics · Doctors · Specialists</p>
      </div>
      <div class="hero-pets" aria-hidden="true"><span>🐶</span><span>🐱</span></div>
    </div>

    <div class="home-content">
      <UniversalSearch variant="hero" />
      <div class="home-categories">
        {[
          ["building", "Hospitals", "/search/?q=hospital"],
          ["store", "Clinics", "/search/?q=clinic"],
          ["doctor", "Doctors", "/search/?q=doctor"],
          ["sparkle", "Specialists", "/specialties/"],
        ].map(([icon, label, href]) => (
          <a href={href}><span><Icon name={icon} class="icon icon-lg" /></span><b>{label}</b></a>
        ))}
      </div>

      <a class="home-emergency" href="/search/?q=24x7">
        <span class="emergency-icon">🚑</span>
        <span><strong>Emergency Care?</strong><small>Find nearby 24x7 veterinary hospitals</small></span>
        <b>Find Now <Icon name="arrow" class="icon icon-sm" /></b>
      </a>

      <div class="home-actions-grid">
        <a class="home-action specialist-action" href="/specialties/"><Icon name="stethoscope" class="icon icon-xl" /><span><strong>Find a<br />Specialist</strong><small>Expert care for<br />your pet's needs</small></span><i>→</i></a>
        <a class="home-action cost-action" href="/costs/"><Icon name="wallet" class="icon icon-xl" /><span><strong>Estimate<br />Consultation Cost</strong><small>Plan better,<br />care smarter</small></span><i>→</i></a>
      </div>

      <section class="home-section">
        <div class="home-section-head"><h2><span>★</span> Top Veterinary Hospitals</h2><a href="/search/">See All →</a></div>
        <div class="hospital-scroller">
          {featured.map((provider) => {
            const city = cityById(provider.cityId);
            return <a class="hospital-card" href={`/${city?.slug}/${provider.slug}/`}>
              <div class="hospital-image"><FacilityVisual type={provider.type} seed={provider.slug} />{provider.rating ? <span>★ {provider.rating.toFixed(1)}</span> : <span>Rating not verified</span>}</div>
              <strong>{provider.name}</strong>
              <small><Icon name="pin" class="icon icon-sm" /> {provider.area}, {city?.name}</small>
              <em><Icon name={provider.hours.open24 ? "clock" : "paw"} class="icon icon-sm" /> {provider.hours.open24 ? "24×7 listed" : "View details"} <b>→</b></em>
            </a>;
          })}
        </div>
      </section>

      <section class="home-section pet-section">
        <div class="home-section-head"><h2><span>♣</span> Find by Pet Type</h2></div>
        <div class="pet-scroller">
          {petTypes.map((pet) => <a href={`/search/?q=${pet.query}`}><span>{pet.emoji}</span><b>{pet.label} →</b></a>)}
        </div>
      </section>

      <a class="home-promise" href="/about/"><span>💙🐾</span><span><strong>Healthy Pets. Happy Lives.</strong><small>Trusted veterinary care, always nearby.</small></span><b>Explore More →</b></a>
    </div>
  </section>
</BaseLayout>
