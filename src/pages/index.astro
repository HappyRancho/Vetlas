---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import UniversalSearch from "../components/UniversalSearch.astro";
import FeaturedFacility from "../components/FeaturedFacility.astro";
import { cities, providers, specialties, specialtyById } from "@data";

const chipCities = cities.slice(0, 6);

const discovery = [
  { href: "/search/?type=hospital", label: "Hospitals", icon: "hospital", sub: `${providers.filter((p) => p.type === "hospital").length} listings` },
  { href: "/search/?type=clinic", label: "Clinics", icon: "building", sub: `${providers.filter((p) => p.type === "clinic").length} listings` },
  { href: "/search/?type=doctor", label: "Doctors", icon: "doctor", sub: "Browse by speciality" },
  { href: "/specialties/", label: "Specialists", icon: "stethoscope", sub: `${specialties.length} areas of care` },
];

const specSlugs = ["general-practice", "surgery", "dermatology", "orthopedics", "ophthalmology", "dentistry"];
const stripSpecs = specSlugs
  .map((slug) => specialties.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const seenCities = new Set<string>();
const featured = providers
  .filter((p) => {
    if (seenCities.has(p.cityId)) return false;
    seenCities.add(p.cityId);
    return true;
  })
  .slice(0, 3);

const pets = [
  { v: "dog", l: "Dogs", icon: "dog" },
  { v: "cat", l: "Cats", icon: "cat" },
  { v: "bird", l: "Birds", icon: "bird" },
  { v: "rabbit", l: "Rabbits", icon: "rabbit" },
  { v: "hamster", l: "Small pets", icon: "hamster" },
  { v: "farm", l: "Farm animals", icon: "cow" },
];
---

<BaseLayout
  title="Vetlas — find veterinary care in India, calmly"
  description="Discover veterinary hospitals, clinics and doctors across India. Compare locations, specialities, facilities, fees and sample ratings — with every fact clearly labelled."
>
  <div class="container home">
    <section class="hero" aria-label="Find veterinary care">
      <div class="hero-copy">
        <h1 class="hero-title">Choose a vet with confidence.</h1>
        <p class="hero-sub">
          Discover veterinary hospitals, clinics and specialists across India.
        </p>

        <UniversalSearch variant="hero" />

        <div class="city-chips" role="group" aria-label="Filter results by city">
          <button type="button" class="city-chip" data-city="" data-name="India" aria-pressed="true">
            <Icon name="pin" class="icon icon-sm" /> All India
          </button>
          {chipCities.map((c) => (
            <button type="button" class="city-chip" data-city={c.slug} data-name={c.name} aria-pressed="false">
              <Icon name="pin" class="icon icon-sm" /> {c.name}
            </button>
          ))}
          <a class="city-chip-more" href="/locations/">
            All {cities.length} cities <Icon name="arrow" class="icon icon-sm" />
          </a>
        </div>
      </div>

      <div class="hero-media">
        <figure class="hero-photo">
          <img
            src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=800&h=600&fit=crop&q=72&fm=jpg"
            srcset="https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=480&h=360&fit=crop&q=70&fm=jpg 480w, https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=800&h=600&fit=crop&q=72&fm=jpg 800w"
            sizes="(min-width: 58em) 24vw, 45vw"
            width="800"
            height="600"
            alt="A happy beagle looking into the camera"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
        <figure class="hero-photo">
          <img
            src="https://images.unsplash.com/photo-1519052537078-e6302a4968d4?w=800&h=600&fit=crop&q=72&fm=jpg"
            srcset="https://images.unsplash.com/photo-1519052537078-e6302a4968d4?w=480&h=360&fit=crop&q=70&fm=jpg 480w, https://images.unsplash.com/photo-1519052537078-e6302a4968d4?w=800&h=600&fit=crop&q=72&fm=jpg 800w"
            sizes="(min-width: 58em) 24vw, 45vw"
            width="800"
            height="600"
            alt="A ginger cat resting on a wooden floor"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <nav class="discover" aria-label="Browse care by type">
      {discovery.map((d) => (
        <a class="discover-card" href={d.href}>
          <span class="discover-icon"><Icon name={d.icon} class="icon icon-lg" /></span>
          <span class="discover-label">{d.label}</span>
          <span class="discover-sub">{d.sub}</span>
        </a>
      ))}
    </nav>

    <section class="emergency" aria-labelledby="emergency-h">
      <span class="emergency-icon" aria-hidden="true"><Icon name="siren" class="icon icon-lg" /></span>
      <div class="emergency-copy">
        <h2 id="emergency-h">Need emergency veterinary care?</h2>
        <p>Find facilities advertising emergency and 24×7 services.</p>
      </div>
      <a class="emergency-action" href="/search/?q=emergency">
        Show now <Icon name="arrow" class="icon" />
      </a>
    </section>

    <section class="home-section" aria-labelledby="specs-h">
      <div class="section-head">
        <div>
          <p class="section-eyebrow">Speciality discovery</p>
          <h2 id="specs-h">Popular specialities</h2>
        </div>
        <a class="link-more" href="/specialties/">
          All {specialties.length} specialities <Icon name="arrow" class="icon" />
        </a>
      </div>
      <div class="spec-strip" role="list">
        {stripSpecs.map((s) => (
          <a class="spec-chip" href={`/specialties/${s.slug}/`} role="listitem">
            <span class="spec-chip-icon"><Icon name={s.icon} class="icon icon-md" /></span>
            <span class="spec-chip-label">{s.name}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="home-section" aria-labelledby="featured-h">
      <div class="section-head">
        <div>
          <p class="section-eyebrow">From the demo dataset</p>
          <h2 id="featured-h">Featured facilities</h2>
          <p>Three sample profiles, one from each city — every profile carries its trust labels.</p>
        </div>
        <a class="link-more" href="/search/">
          See all in search <Icon name="arrow" class="icon" />
        </a>
      </div>
      <div class="featured-grid">
        {featured.map((p) => <FeaturedFacility provider={p} />)}
      </div>
    </section>

    <section class="home-section" aria-labelledby="pets-h">
      <div class="section-head">
        <div>
          <p class="section-eyebrow">Pet-type discovery</p>
          <h2 id="pets-h">Browse care by pet</h2>
        </div>
      </div>
      <div class="pet-grid" role="list">
        {pets.map((p) => (
          <a class="pet-card" href={`/search/?pet=${p.v}`} role="listitem">
            <span class="pet-icon"><Icon name={p.icon} class="icon icon-xl" /></span>
            <span class="pet-label">{p.l}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="transparency" aria-labelledby="transparency-h">
      <span class="transparency-mark" aria-hidden="true"><Icon name="shield" class="icon icon-lg" /></span>
      <h2 id="transparency-h">A little more transparency. A better decision.</h2>
      <p>
        Explore facility information, available services and public-source information before visiting.
        Every number on Vetlas carries a trust label — this prototype runs on clearly-marked sample data.
      </p>
      <div class="transparency-actions">
        <a class="btn btn-primary" href="/methodology/">How the data is checked</a>
        <a class="btn" href="/search/">Browse all care</a>
      </div>
    </section>
  </div>

  <script>
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".city-chip"));
    const KEY = "vetlas-city";

    function apply(citySlug: string) {
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.city === citySlug)));
      try {
        localStorage.setItem(KEY, citySlug);
      } catch {
        /* storage unavailable */
      }
      document.querySelectorAll<HTMLAnchorElement>(".discover-card").forEach((a) => {
        const href = new URL(a.href);
        if (citySlug) href.searchParams.set("city", citySlug);
        else href.searchParams.delete("city");
        a.setAttribute("href", `${href.pathname}${href.search}`);
      });
    }

    chips.forEach((c) => {
      c.addEventListener("click", () => apply(c.dataset.city ?? ""));
    });

    try {
      const saved = localStorage.getItem(KEY);
      const chip = saved ? chips.find((c) => c.dataset.city === saved) : undefined;
      if (saved && chip) apply(saved);
    } catch {
      /* storage unavailable */
    }
  </script>
</BaseLayout>
