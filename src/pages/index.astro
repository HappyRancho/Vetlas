---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import UniversalSearch from "../components/UniversalSearch.astro";
import FacilityCard from "../components/FacilityCard.astro";
import { providers, specialties, cityById, cities } from "@data";

const facilities = providers.filter((provider) => provider.imageUrl).slice(0, 3);
const emergencyFacilities = providers.filter((provider) => provider.hours.open24).slice(0, 3);
const discoverySpecialties = specialties.slice(0, 6);
const listedCities = cities.filter((city) => providers.some((provider) => provider.cityId === city.id));
const petTypes = [
  { label: "Dogs", value: "dog", icon: "paw" },
  { label: "Cats", value: "cat", icon: "paw" },
  { label: "Birds", value: "bird", icon: "bird" },
  { label: "Rabbits", value: "rabbit", icon: "paw" },
  { label: "Small pets", value: "hamster", icon: "heart" },
];
---

<BaseLayout
  title="Vetlas — find the right veterinary care"
  description="Discover veterinary clinics, hospitals and specialists across India. Explore facilities, services, doctors and available information before choosing where to go."
>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="container home-hero-inner">
        <div class="home-hero-copy">
          <p class="eyebrow"><Icon name="paw" class="icon" /> Veterinary care, made easier</p>
          <h1 id="home-title">Choose a vet<br /><span>with confidence.</span></h1>
          <p class="home-hero-lede">
            Discover veterinary hospitals, clinics and specialists. Explore available services,
            facilities and public information before visiting.
          </p>
          <UniversalSearch variant="hero" id="home-search" />
          <p class="home-disclaimer"><Icon name="info" class="icon" /> Sample data is clearly labelled while Vetlas is in beta.</p>
        </div>
        <div class="home-hero-art" aria-hidden="true">
          <div class="hero-art-orbit hero-art-orbit-one"></div>
          <div class="hero-art-orbit hero-art-orbit-two"></div>
          <div class="hero-art-card">
            <Icon name="stethoscope" class="icon icon-xl" />
            <span>Care that starts<br /><b>with confidence.</b></span>
          </div>
          <div class="hero-art-paw"><Icon name="paw" class="icon icon-xl" /></div>
        </div>
      </div>
    </section>

    <div class="container home-main">
      <section class="discovery-section" aria-labelledby="discover-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Start exploring</p>
            <h2 id="discover-title">What are you looking for?</h2>
          </div>
          <a class="section-link" href="/search/">View all care <Icon name="arrow" class="icon" /></a>
        </div>
        <div class="discovery-grid">
          <a class="discovery-card" href="/hospitals/">
            <span class="discovery-icon discovery-icon-blue"><Icon name="building" class="icon icon-lg" /></span>
            <span><b>Veterinary hospitals</b><small>Round-the-clock and specialist care</small></span>
            <Icon name="arrow" class="icon discovery-arrow" />
          </a>
          <a class="discovery-card" href="/clinics/">
            <span class="discovery-icon discovery-icon-mint"><Icon name="store" class="icon icon-lg" /></span>
            <span><b>Veterinary clinics</b><small>Everyday care, close to home</small></span>
            <Icon name="arrow" class="icon discovery-arrow" />
          </a>
          <a class="discovery-card" href="/doctors/">
            <span class="discovery-icon discovery-icon-lilac"><Icon name="doctor" class="icon icon-lg" /></span>
            <span><b>Veterinary doctors</b><small>Explore doctors and their practice</small></span>
            <Icon name="arrow" class="icon discovery-arrow" />
          </a>
          <a class="discovery-card" href="/specialists/">
            <span class="discovery-icon discovery-icon-sand"><Icon name="stethoscope" class="icon icon-lg" /></span>
            <span><b>Specialists</b><small>Find care by area of expertise</small></span>
            <Icon name="arrow" class="icon discovery-arrow" />
          </a>
          <a class="discovery-card discovery-card-emergency" href="/emergency/">
            <span class="discovery-icon"><Icon name="siren" class="icon icon-lg" /></span>
            <span><b>Emergency care</b><small>Find facilities listing 24×7 hours</small></span>
            <Icon name="arrow" class="icon discovery-arrow" />
          </a>
        </div>
      </section>

      <section class="home-callout emergency-callout" aria-labelledby="emergency-title">
        <div class="callout-icon"><Icon name="siren" class="icon icon-lg" /></div>
        <div>
          <p class="eyebrow">For urgent searches</p>
          <h2 id="emergency-title">Facilities listing 24×7 hours</h2>
          <p>Explore the sample directory and confirm availability directly with a facility before travelling.</p>
        </div>
        <a class="btn btn-emergency" href="/search/?q=24x7">Find emergency care <Icon name="arrow" class="icon" /></a>
      </section>

      <section class="home-section" aria-labelledby="featured-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Explore the directory</p>
            <h2 id="featured-title">Facilities to explore</h2>
          </div>
          <a class="section-link" href="/search/">See all <Icon name="arrow" class="icon" /></a>
        </div>
        <p class="section-note">A sample selection from the Vetlas directory — not a paid or quality ranking.</p>
        <div class="facility-grid home-facility-grid">
          {facilities.map((provider, index) => <FacilityCard provider={provider} index={index} />)}
        </div>
      </section>

      <section class="home-section home-city-section" aria-labelledby="cities-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Where to start</p>
            <h2 id="cities-title">Popular cities</h2>
          </div>
          <a class="section-link" href="/locations/">All cities <Icon name="arrow" class="icon" /></a>
        </div>
        <div class="home-city-row" aria-label="Cities with listings">
          {listedCities.map((city) => (
            <a class="home-city-chip" href={`/${city.slug}/`}><Icon name="pin" class="icon" /> {city.name}</a>
          ))}
        </div>
      </section>

      <section class="home-section" aria-labelledby="specialties-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Browse by need</p>
            <h2 id="specialties-title">Find a speciality</h2>
          </div>
          <a class="section-link" href="/specialties/">All specialities <Icon name="arrow" class="icon" /></a>
        </div>
        <div class="specialty-grid">
          {discoverySpecialties.map((specialty) => (
            <a class="specialty-tile" href={`/specialties/${specialty.slug}/`}>
              <span class="specialty-tile-icon"><Icon name={specialty.icon} class="icon icon-md" /></span>
              <span><b>{specialty.name}</b><small>{specialty.tagline}</small></span>
              <Icon name="arrow" class="icon" />
            </a>
          ))}
        </div>
      </section>

      <section class="home-section emergency-list-section" aria-labelledby="availability-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Availability information</p>
            <h2 id="availability-title">24×7 listings</h2>
          </div>
          <a class="section-link" href="/search/?q=24x7">View all <Icon name="arrow" class="icon" /></a>
        </div>
        <p class="section-note">These facilities list round-the-clock hours or emergency services. Please confirm before visiting.</p>
        <div class="compact-facility-list">
          {emergencyFacilities.map((provider) => {
            const city = cityById(provider.cityId);
            return <a class="compact-facility" href={`/${city?.slug}/${provider.slug}/`}>
              <span class="compact-facility-icon"><Icon name="building" class="icon icon-md" /></span>
              <span><b>{provider.name}</b><small>{provider.area} · 24×7 listed · sample</small></span>
              <Icon name="arrow" class="icon" />
            </a>;
          })}
        </div>
      </section>

      <section class="home-section" aria-labelledby="pets-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Care for every companion</p>
            <h2 id="pets-title">Browse by pet</h2>
          </div>
        </div>
        <div class="pet-type-row">
          {petTypes.map((pet) => (
            <a class="pet-type-card" href={`/search/?pet=${pet.value}`}>
              <span class="pet-type-icon"><Icon name={pet.icon} class="icon icon-md" /></span>
              <span>{pet.label}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="home-trust-grid" aria-labelledby="trust-title">
        <div>
          <p class="eyebrow">A clearer way to choose</p>
          <h2 id="trust-title">Explore the details that matter.</h2>
          <p>Vetlas brings useful information into one place so you can compare options without confusing advertising or hidden placement.</p>
        </div>
        <ul class="trust-points">
          <li><Icon name="building" class="icon" /><span><b>Facility information</b><small>Locations, hours, services and infrastructure.</small></span></li>
          <li><Icon name="doctor" class="icon" /><span><b>Doctor information</b><small>Practice details and supported specialities where available.</small></span></li>
          <li><Icon name="badge" class="icon" /><span><b>Clear data labels</b><small>Ratings, fees and reviews are marked as sample or sourced.</small></span></li>
        </ul>
      </section>

      <section class="home-contribute" aria-labelledby="contribute-title">
        <div>
          <p class="eyebrow">Help improve the directory</p>
          <h2 id="contribute-title">Own a veterinary practice?</h2>
          <p>Suggest a listing or share updated information so future pet owners can find accurate care details.</p>
        </div>
        <a class="btn btn-secondary" href="/about/">Suggest an update <Icon name="arrow" class="icon" /></a>
      </section>
    </div>
  </div>
</BaseLayout>
