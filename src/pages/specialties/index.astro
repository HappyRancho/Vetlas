---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DirectoryHeader from "../../components/DirectoryHeader.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";
import {specialties,providersBySpecialty,doctorsBySpecialty} from "@data";
import {specialityGroups} from "../../data/speciality-visits";
import "../../styles/specialities.css";

const rows = specialties.map(s=>{
  const places=providersBySpecialty(s.id), vets=doctorsBySpecialty(s.id);
  return {...s,count:places.length+vets.length,cities:new Set([...places,...vets].map(p=>p.cityId)).size};
});
const schema={"@context":"https://schema.org","@type":"CollectionPage",name:"Veterinary specialities in India",url:new URL("/specialties/",Astro.site),mainEntity:{"@type":"ItemList",numberOfItems:rows.length,itemListElement:rows.map((s,i)=>({"@type":"ListItem",position:i+1,name:s.name,url:new URL(`/specialties/${s.slug}/`,Astro.site)}))}};
---
<BaseLayout title="Veterinary specialities in India | Vetlas" description="Explore veterinary specialities by the care your animal needs. Find local clinics and veterinarians, questions to ask and what to bring." canonical="/specialties/">
  <script type="application/ld+json" set:html={JSON.stringify(schema)}/>
  <div class="container spec-directory">
    <Breadcrumbs items={[{name:"Home",href:"/"},{name:"Specialities",href:"/specialties/"}]}/>
    <DirectoryHeader label="Speciality directory" title="Find the right kind of vet" description="Explore care by the reason for your visit, then choose a city to see local clinics and veterinarians.">
      <label class="spec-search" hidden><Icon name="search"/><span class="visually-hidden">Filter specialities</span><input type="search" placeholder="Search by speciality or concern, e.g. skin" autocomplete="off"/></label>
    </DirectoryHeader>
    <div class="spec-help"><a href="/specialties/general-practice/"><Icon name="stethoscope"/>Start with a general vet</a><a href="/emergency/"><Icon name="siren"/>Find urgent care</a></div>
    {specialityGroups.map(group=><section class="spec-section" data-speciality-group>
      <h2>{group.name}</h2><div class="spec-index">
        {group.ids.map(id=>rows.find(s=>s.id===id)!).map(s=><a class="spec-link" href={`/specialties/${s.slug}/`} data-terms={[s.name,s.tagline,s.description].join(" ").toLowerCase()}>
          <img src={`/specialities/${s.id}.webp`} alt="" width="90" height="90" loading="lazy"/>
          <span><strong>{s.name}</strong><span>{s.tagline}</span><small>{s.count ? `${s.count} ${s.count===1?"listing":"listings"} · ${s.cities} ${s.cities===1?"city":"cities"}` : "Visit preparation guide"}</small></span><Icon name="arrow"/>
        </a>)}
      </div>
    </section>)}
    <p class="spec-empty" data-filter-empty hidden>No specialities match that search. <button type="button">Show all specialities</button></p>
    <p class="visually-hidden" role="status" data-filter-status></p>
    <nav class="spec-links" aria-label="Browse locations"><a href="/locations/">Browse all cities</a></nav>
  </div>
</BaseLayout>
<script>
 const field=document.querySelector<HTMLInputElement>('.spec-search input')!;
 const groups=document.querySelectorAll<HTMLElement>('[data-speciality-group]');
 const empty=document.querySelector<HTMLElement>('[data-filter-empty]')!;
 const status=document.querySelector<HTMLElement>('[data-filter-status]')!;
 function filter() {
   const words=field.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
   let matches=0;
   for(const group of groups) {
     const cards=Array.from(group.querySelectorAll<HTMLElement>('[data-terms]'));
     for(const card of cards) card.hidden=!words.every(word=>card.dataset.terms!.includes(word));
     const count=cards.filter(card=>!card.hidden).length;
     group.hidden=count===0;matches+=count;
   }
   empty.hidden=matches>0;status.textContent=matches+' matching specialities';
 }
 field.parentElement!.hidden=false;
 field.addEventListener('input',filter);
 empty.querySelector('button')!.addEventListener('click',()=>{field.value='';filter();field.focus();});
</script>
