---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import TrustBadge from "../../components/TrustBadge.astro";
import {
  specialties, providersBySpecialty, doctorsBySpecialty,
} from "@data";

const withCount = specialties.map((specialty) => ({
  specialty,
  count: providersBySpecialty(specialty.id).length + doctorsBySpecialty(specialty.id).length,
}));
---

<BaseLayout
  title="All veterinary specialities — Vetlas"
  description="Explore veterinary specialities in India — medicine, surgery, dermatology, gynaecology & obstetrics, cardiology, gastroenterology, ophthalmology, neurology and oncology."
  canonical="/specialties/"
>
  <div class="container">
    <header class="page-head animate-fade-up">
      <p class="eyebrow"><Icon name="stethoscope" class="icon icon-md" /> Speciality directory</p>
      <h1 class="mt-05">Find the right kind of vet</h1>
      <p>
        Not sure who to see? Each speciality explains what it covers and lists the hospitals,
        clinics and doctors who practise it. Start broad, then narrow by city.
      </p>
      <div class="mt-75"><TrustBadge level="public" label="Public listings" /></div>
    </header>

    <ul class="specialty-grid mt-2 pb-1">
      {withCount.map(({ specialty, count }) => (
        <li>
          <a class="specialty-card" href={`/specialties/${specialty.slug}/`}>
            <span class="specialty-icon"><Icon name={specialty.icon} class="icon icon-md" /></span>
            <span class="specialty-copy">
              <b>{specialty.name}</b>
              <span>{specialty.tagline} · {count} public listings</span>
            </span>
            <Icon name="arrow" class="icon specialty-arrow" />
          </a>
        </li>
      ))}
    </ul>

    <section class="section" aria-labelledby="city-h">
      <div class="section-head">
        <div>
          <p class="section-eyebrow">Another way in</p>
          <h2 class="section-title section-title-sm" id="city-h">Prefer to browse by city?</h2>
        </div>
        <a class="link-more" href="/locations/">All cities <Icon name="arrow" class="icon" /></a>
      </div>
      <p class="soft small">
        City pages group every hospital, clinic and doctor by location, with facilities and
        consultation fees at a glance.
      </p>
    </section>
  </div>
</BaseLayout>
