---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import FacilityCard from "../../components/FacilityCard.astro";
import DoctorCard from "../../components/DoctorCard.astro";
import UniversalSearch from "../../components/UniversalSearch.astro";
import TrustBadge from "../../components/TrustBadge.astro";
import {
  specialties, cities, providersBySpecialty, doctorsBySpecialty,
} from "@data";

export function getStaticPaths() {
  return specialties.map((specialty) => ({ params: { slug: specialty.slug }, props: { specialty } }));
}

const { specialty } = Astro.props;
const providerList = providersBySpecialty(specialty.id);
const doctorList = doctorsBySpecialty(specialty.id);
const vettedCount = 0; // sample dataset
const noindex = vettedCount < 3; // spec §6: combination pages need ≥3 vetted providers

const cityLinks = cities.filter((city) =>
  providerList.some((p) => p.cityId === city.id) || doctorList.some((d) => d.cityId === city.id)
);
---

<BaseLayout
  title={`${specialty.name} — vets across India`}
  description={`${specialty.description} Find ${specialty.name.toLowerCase()} clinics and doctors across India on Vetlas.`}
  noindex={noindex}
  canonical={`/specialties/${specialty.slug}/`}
>
  <div class="container">
    <a class="back-link mt-15" href="/specialties/">
      <Icon name="back" class="icon icon-md" /> All specialities
    </a>

    <header class="page-head page-head-row page-head-row-top animate-fade-up">
      <span class="card-icon card-icon-lg">
        <Icon name={specialty.icon} class="icon icon-xl" />
      </span>
      <div>
        <p class="eyebrow">{specialty.tagline}</p>
        <h1>{specialty.name}</h1>
        <p class="soft head-desc">{specialty.description}</p>
        <div class="profile-tags">
          <TrustBadge level="sample" label="Sample listings" />
          <span class="chip chip-sm">Across {cities.length} cities</span>
        </div>
      </div>
    </header>

    <section class="section-first" aria-labelledby="search-h">
      <h2 class="visually-hidden" id="search-h">Search for care</h2>
      <UniversalSearch variant="compact" />
    </section>

    {cityLinks.length > 0 && (
      <section class="section-compact" aria-labelledby="cities-h">
        <div class="section-head">
          <div>
            <p class="section-eyebrow">By location</p>
            <h2 class="section-title section-title-sm" id="cities-h">Where to find {specialty.name.toLowerCase()}</h2>
          </div>
        </div>
        <ul class="list-inline">
          {cityLinks.map((city) => (
            <li><a class="chip" href={`/${city.slug}/${specialty.slug}/`}><Icon name="pin" class="icon" />{city.name}</a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="section-first" aria-labelledby="sp-p">
      <div class="section-head">
        <div>
          <p class="section-eyebrow">Facilities</p>
          <h2 class="section-title section-title-sm" id="sp-p">Clinics &amp; hospitals</h2>
        </div>
        <TrustBadge level="sample" label="Sample data" />
      </div>
      {providerList.length > 0 ? (
        <div class="facility-grid">
          {providerList.map((p, i) => <FacilityCard provider={p} index={i} />)}
        </div>
      ) : (
        <div class="empty-state card">
          <span class="icon-wrap"><Icon name="search" class="icon icon-xl" /></span>
          <h2>No clinics listed yet</h2>
          <p>We haven't added {specialty.name.toLowerCase()} facilities to the sample dataset yet.</p>
          <div class="actions"><a class="btn btn-primary" href="/search/">Browse all clinics</a></div>
        </div>
      )}
    </section>

    <section class="section-compact pb-1" aria-labelledby="sp-d">
      <div class="section-head">
        <div>
          <p class="section-eyebrow">Doctors</p>
          <h2 class="section-title section-title-sm" id="sp-d">Veterinarians in this speciality</h2>
        </div>
        <TrustBadge level="sample" label="Sample data" />
      </div>
      {doctorList.length > 0 ? (
        <div class="doctor-grid">
          {doctorList.map((d, i) => <DoctorCard doctor={d} index={i} />)}
        </div>
      ) : (
        <div class="empty-state card">
          <span class="icon-wrap"><Icon name="doctor" class="icon icon-xl" /></span>
          <h2>No doctors listed yet</h2>
          <p>No {specialty.name.toLowerCase()} doctors in the sample dataset yet.</p>
          <div class="actions"><a class="btn btn-primary" href="/search/?type=doctor">Browse all doctors</a></div>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
