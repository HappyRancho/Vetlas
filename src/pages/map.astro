---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CareMap from '../components/CareMap.astro';
import { providersByCity } from "@data";
const count = providersByCity("indore").filter(p=>p.coordinates).length;
---
<BaseLayout noindex={!count} title="Indore veterinary clinic map — locations and directions | Vetlas" description="Explore Indore veterinary clinics on an interactive map. Filter by pet and service, find nearby care, compare listed fees and open sourced locations in Google Maps.">
 <div class="container"><Breadcrumbs items={[{name:'Home',href:'/'},{name:'Indore',href:'/indore/'},{name:'Clinic map',href:'/map/'}]}/><header class="map-page-heading"><p class="eyebrow">Good care, closer to home</p><h1>Find veterinary care in Indore.</h1><p>{count} mapped clinics. Compare locations, find your doctor and plan the visit.</p><a href="/indore/veterinarians/">Meet Indore’s veterinarians →</a></header>{count > 0 && <CareMap/>}</div>
</BaseLayout>
<style>.map-page-heading{margin:1.3rem 0}.map-page-heading h1{font-size:clamp(1.8rem,4.7vw,3rem);margin:.4rem 0}.map-page-heading p{font-size:.9rem}.map-page-heading>a{font-size:.85rem;color:#0f306e}</style>
