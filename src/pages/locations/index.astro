---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { cities, providers, doctors } from "@data";

/** City index — shows publication gate status per city (spec §2). */
const minFor = (c: (typeof cities)[number]) => (c.isMetro ? 30 : 15);
const countFor = (c: (typeof cities)[number]) =>
  providers.filter((p) => p.cityId === c.id).length + doctors.filter((d) => d.cityId === c.id).length;
---

<BaseLayout
  title="Veterinary care by city — Vetlas"
  description="Find veterinary clinics, hospitals and doctors across India — Bengaluru, Mumbai, Delhi NCR, Hyderabad, Chennai, Pune, Kolkata, Jaipur, Ahmedabad and Kochi."
  canonical="/locations/"
>
  <div class="container">
    <header class="page-head">
      <h1>Care in your city</h1>
      <p>
        We're mapping India's veterinary infrastructure city by city. A city page goes live for
        search engines only once it meets Vetlas' quality thresholds — accuracy over volume.
      </p>
    </header>

    <ul class="index-list mt-2 pb-1">
      {cities.map((c) => {
        const n = countFor(c);
        const min = minFor(c);
        return (
          <li>
            <a class="index-row" href={`/${c.slug}/`}>
              <span class="index-name">
                {c.name}
                {c.isMetro && <span class="chip chip-xs">Metro</span>}
              </span>
              <span class="index-meta">{c.state} · publish minimum {min} vetted profiles</span>
              <span class="index-count">{n} sample profiles</span>
              <Icon name="arrow" class="icon index-arrow" />
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>
