---
import Layout from "../../layouts/BaseLayout.astro";
import { cities, providersByCity } from "@data";
---
<Layout title="Veterinary care by city | Vetlas" description="Browse ten city directories for veterinary practices, branch addresses and contact information across India.">
<div class="container atlas"><header class="city-mast"><p class="kicker">City directory</p><h1>Care in your city</h1><p>Choose a city to compare local clinics, hospitals and published services.</p></header>
<div class="atlas-cities">{cities.map(c=><a href={'/'+c.slug+'/'}><strong>{c.name}</strong><small>{c.state} · {providersByCity(c.id).length} facilities</small><span>↗</span></a>)}</div></div></Layout>
