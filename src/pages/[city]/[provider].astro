---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import FacilityMedia from '../../components/FacilityMedia.astro';
import RatingSummary from '../../components/RatingSummary.astro';
import VetCard from '../../components/VetCard.astro';
import DoctorCard from '../../components/DoctorCard.astro';
import MapPreview from '../../components/MapPreview.astro';
import CostVote from '../../components/CostVote.astro';
import { providers, providersDoctors, cityById, specialtyById } from '@data';
import { vetsForFacility } from '../../data/veterinarians';
import { googleDirections } from '../../lib/map-links.mjs';
import { consultationLabel, hoursLabel } from '../../lib/visit-info.mjs';
export function getStaticPaths(){return providers.map(provider=>({params:{city:cityById(provider.cityId)!.slug,provider:provider.slug},props:{provider}}));}
const {provider:p}=Astro.props,city=cityById(p.cityId)!,vets=vetsForFacility(p.id),puneVets=providersDoctors(p),fee=consultationLabel(p),path=`/${city.slug}/${p.slug}/`;
const schema={'@context':'https://schema.org','@type':'VeterinaryCare','@id':new URL(path,Astro.site).href+'#facility',name:p.name,url:new URL(path,Astro.site).href,telephone:p.phone,employee:[...vets,...puneVets].map(d=>({'@id':new URL('/'+city.slug+'/veterinarians/'+d.slug+'/#person',Astro.site).href})),image:p.imageUrl?new URL(p.imageUrl,Astro.site).href:undefined,address:{'@type':'PostalAddress',streetAddress:p.address,addressLocality:city.name,addressRegion:city.state,addressCountry:'IN'},...(p.coordinates?{geo:{'@type':'GeoCoordinates',latitude:p.coordinates.lat,longitude:p.coordinates.lng},hasMap:p.coordinateSource}:{}),...(p.visitHours?.openingHours?{openingHours:p.visitHours.openingHours}:{}),...(p.fees?{priceRange:`INR ${p.fees.opd}${p.feeIsStarting?'+':''}`}:{})};
---
<BaseLayout title={`${p.name}, ${p.area} — fees, timings & doctors | Vetlas`} description={`${p.name} in ${p.area}, ${city.name}. Find sourced consultation information, clinic timings, services and directions.`} canonical={path} >
 <script type="application/ld+json" set:html={JSON.stringify(schema)}/>
 <div class="container clinic-profile">
  <Breadcrumbs items={[{name:'Home',href:'/'},{name:city.name,href:`/${city.slug}/`},{name:p.name,href:path}]}/>
  <header class:list={["clinic-identity", {"source-photo": !p.imageUrl}]}>{p.imageUrl && <div class="clinic-cover"><FacilityMedia provider={p} large/></div>}<div class="clinic-heading"><p class="eyebrow">{p.type} · {city.name}</p><h1>{p.name}</h1><p><Icon name="pin" class="icon"/>{p.area}</p><RatingSummary provider={p} compact/><div class="clinic-head-actions">{p.phone&&<a class="btn btn-primary" href={`tel:${p.phone.replace(/[^+\d]/g,'')}`}><Icon name="phone" class="icon"/>Call clinic</a>}{!p.locationUnconfirmed&&<a class="btn btn-secondary" href={googleDirections(p)} target="_blank" rel="noreferrer"><Icon name="pin" class="icon"/>Directions</a>}<a class="btn btn-secondary" href="#reviews">Reviews</a></div></div></header>
  <nav class="clinic-section-nav" aria-label="Clinic sections"><a href="#overview">Overview</a><a href="#visit">Timings & fees</a>{(vets.length>0||puneVets.length>0)&&<a href="#doctors">Doctors</a>}<a href="#location">Map</a><a href="#visit-costs">Visit costs</a></nav>
  <div class="clinic-layout"><aside class="clinic-visit panel" id="visit"><p class="eyebrow">Plan your visit</p><h2>Consultation & timings</h2><div class="fee-detail"><strong>{fee.amount}</strong><small>{fee.caption}</small></div>
   {p.visitHours?.schedule?<dl class="visit-schedule">{p.visitHours.schedule.map(row=><div><dt>{row.days}</dt><dd>{row.time}</dd></div>)}</dl>:<p class="small">{hoursLabel(p)}</p>}
   {p.visitHours?.doctorSummary&&<p class="visit-doctor-hours"><strong>Doctor hours</strong><br/>{p.visitHours.doctorSummary}</p>}
   {p.visitHours?.note&&<p class="small">{p.visitHours.note}</p>}
   <h3>Address</h3><p>{p.address}</p>{p.hoursNote && <p>{p.hoursNote}</p>}{p.phone&&<a class="clinic-phone" href={`tel:${p.phone.replace(/[^+\d]/g,'')}`}><Icon name="phone" class="icon"/>{p.phone}</a>}
   {p.locationUnconfirmed?<p class="small">Street address has not been confirmed. Verify the clinic’s location before travelling.</p>:<a class="btn btn-primary" href={googleDirections(p)} target="_blank" rel="noreferrer">Get directions →</a>}
   {p.sources?.website&&<a class="clinic-website" href={p.sources.website} target="_blank" rel="noreferrer">Visit clinic website →</a>}
  </aside><div class="clinic-content">
   <section class="panel" id="overview"><p class="eyebrow">Care at a glance</p><h2>About the clinic</h2><p>{p.about}</p><div class="list-inline">{p.specialtyIds.map(id=>{const s=specialtyById(id);return s&&<a class="chip" href={`/specialties/${s.slug}/`}>{s.name}</a>})}</div><h3>Services</h3><ul class="service-list">{p.services.map(s=><li><Icon name="check" class="icon"/>{s}</li>)}</ul>{p.species.length>0&&<p class="clinic-pets">Cares for {p.species.map(s=>({dog:'dogs',cat:'cats',bird:'birds',rabbit:'rabbits'}[s]||s)).join(' · ')}</p>}</section>
   {(vets.length>0||puneVets.length>0)&&<section class="panel" id="doctors"><h2>Meet the doctor{vets.length+puneVets.length>1?'s':''}</h2><div class="doctor-grid">{vets.map(vet=><VetCard vet={vet} practiceId={p.id}/>)}{puneVets.map(doctor=><DoctorCard doctor={doctor}/>)}</div>{puneVets.some(doctor=>doctor.dataSource==='user-submitted')&&<p class="small">The submitted doctor–clinic association is not independently confirmed. Contact the practice before travelling.</p>}</section>}
   <section class="panel" id="location"><h2>Find the clinic</h2><p>{p.area}, {city.name}</p>{p.coordinates ? <MapPreview providerId={p.id}/> : !p.locationUnconfirmed && <a href={googleDirections(p)}>Open directions in Google Maps →</a>}</section>
   <section class="panel" id="visit-costs"><p class="eyebrow">Know what to budget</p><h2>Consultation & visit costs</h2><p><strong>{fee.amount}</strong> · {fee.caption}</p>{p.consultationListing?<p>{p.consultationListing.note}</p>:p.feeNote&&<p>{p.feeNote}</p>}<p class="small">Tests, medicines and procedures may be charged separately. Share your total visit cost below.</p><CostVote providerId={p.id}/></section>
   <section class="panel" id="reviews"><div class="panel-head"><h2>Reviews & experiences</h2><a class="btn btn-secondary" href={`/review/?provider=${p.slug}`}>Share your visit</a></div><RatingSummary provider={p}/></section>
   <details class="panel clinic-evidence"><summary>Listing details & photo credits</summary><p class="small">Checked {p.lastChecked}. Details come from clinic websites and public listings; confirm appointment availability with the clinic.</p>{p.visitHours&&<p class="small"><a href={p.visitHours.sourceUrl} target="_blank" rel="noreferrer">Timetable: {p.visitHours.sourceLabel}</a></p>}{p.consultationListing&&<p class="small"><a href={p.consultationListing.sourceUrl} target="_blank" rel="noreferrer">Published consultation listing</a></p>}<ul class="evidence-list">{p.evidence?.map(e=><li><a href={e.url} target="_blank" rel="noreferrer">{e.label}</a></li>)}</ul><p class="small">{p.mapLocation?.note}</p>{p.researchNote&&<p class="small"><strong>Research notes:</strong> {p.researchNote} · Source confidence: {p.confidence ?? "unknown"} (not clinical quality).</p>}{p.sources?.practo&&<p class="small"><a href={p.sources.practo} target="_blank" rel="noreferrer">Practo / professional source</a></p>}{p.sources?.directory&&<p class="small"><a href={p.sources.directory} target="_blank" rel="noreferrer">Directory source</a></p>}{p.sources?.aggregate&&<p class="small"><a href={p.sources.aggregate} target="_blank" rel="noreferrer">Aggregated directory source</a></p>}{p.imageLicenseUrl && <p><a href={p.imageLicenseUrl}>Image licence</a></p>}{p.imageSourceUrl&&<p class="small">Photo: <a href={p.imageSourceUrl} target="_blank" rel="noreferrer">{p.imageCredit ?? "Original photo source"}</a></p>}<a class="small" href={`/methodology/`}>How we organise directory information →</a></details>
   <a class="report-link" href={`mailto:hello@thatvetguy.net?subject=${encodeURIComponent('Update Vetlas listing: '+p.name)}`}>Suggest a correction</a>
  </div></div>
 </div>
</BaseLayout>
<style>.clinic-profile{padding-bottom:2rem}.clinic-identity{display:grid;grid-template-columns:35% 1fr;border:1px solid #d8dfe8;border-radius:24px;overflow:hidden;background:#fff;margin:1rem 0}.clinic-cover{min-height:230px;overflow:hidden}.clinic-cover :global(.fac-visual){height:100%;min-height:230px}.clinic-heading{padding:22px;min-width:0;background:linear-gradient(120deg,#fff,#f0f5fa)}.clinic-heading h1{font-size:clamp(23px,3vw,34px);line-height:1.15;letter-spacing:-.035em;margin:8px 0}.clinic-heading>p:not(.eyebrow){font-size:13px;display:flex;align-items:center;gap:5px;color:#4a5e7f}.clinic-head-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.clinic-head-actions .btn{font-size:12px;padding:10px 14px}.clinic-section-nav{display:flex;gap:7px;overflow:auto;margin:12px 0}.clinic-section-nav a{white-space:nowrap;background:#fff;border:1px solid #dce3eb;padding:10px 14px;border-radius:99px;color:#0d2a61;font-size:12px;min-height:40px}.clinic-layout{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:18px;align-items:start}.clinic-visit{grid-column:2;grid-row:1;padding:18px;position:sticky;top:85px}.clinic-content{grid-column:1;grid-row:1;display:grid;gap:14px;min-width:0}.clinic-content>.panel{padding:19px}.clinic-layout h2{font-size:21px;margin:5px 0 12px}.clinic-layout h3{font-size:15px;margin:15px 0 8px}.clinic-layout p{font-size:13px;line-height:1.65}.clinic-layout .eyebrow{font-size:10px}.clinic-visit>.btn{width:100%;margin-top:12px}.clinic-phone{display:flex;gap:7px;align-items:center;font-size:14px;color:#0f306e}.clinic-website{display:block;text-align:center;font-size:12px;margin-top:12px}.clinic-evidence summary{font-size:12px;font-weight:600;color:#495b7b;cursor:pointer;min-height:26px}.clinic-content .service-list{font-size:12px}.clinic-content .list-inline{flex-wrap:wrap}.clinic-content .chip{font-size:11px}.clinic-pets{background:#eef4fc;border-radius:10px;padding:8px 12px}.clinic-content section{scroll-margin-top:90px}.clinic-content .panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.clinic-content .panel-head .btn{font-size:11px;padding:9px 12px}.clinic-content :global(.doctor-grid){grid-template-columns:1fr}@media(max-width:760px){.clinic-layout{display:flex;flex-direction:column;gap:14px}.clinic-visit{position:static;width:100%;padding:15px}.clinic-content{width:100%}.clinic-identity{grid-template-columns:105px minmax(0,1fr)}.clinic-cover,.clinic-cover :global(.fac-visual){min-height:210px}.clinic-heading{padding:13px}.clinic-heading h1{font-size:20px}.clinic-heading>p:not(.eyebrow){font-size:11px}.clinic-head-actions{gap:5px}.clinic-head-actions .btn{font-size:10px;padding:8px 10px;min-height:36px}.clinic-content>.panel{padding:15px}.clinic-layout h2{font-size:19px}.clinic-visit .visit-schedule{margin:8px 0}.clinic-section-nav a{font-size:11px;padding:8px 12px}.clinic-heading .eyebrow{font-size:9px}}</style>
