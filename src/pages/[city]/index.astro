---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import ProviderLedgerRow from "../../components/ProviderLedgerRow.astro";
import DoctorLedgerRow from "../../components/DoctorLedgerRow.astro";
import SearchBuilder from "../../components/SearchBuilder.astro";
import TrustBadge from "../../components/TrustBadge.astro";
import {
  cities, providers, doctors, reviews, getCity, deriveReviewThemes,
  providersByCity, doctorsByCity,
} from "@data";

/** Minimum vetted profiles required to publish a city (spec §2) */
const PUBLISH_MINIMUM: Record<number, number> = { 1: 30, 2: 15, 3: 5 };

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const cityProviders = providersByCity(city.id);
const cityDoctors = doctorsByCity(city.id);

const themeFor = (slug: string) =>
  deriveReviewThemes(reviews.filter((r) => r.targetSlug === slug))[0]?.theme;

const tierMin = PUBLISH_MINIMUM[city.isMetro ? 1 : 2] ?? 5;
const profileCount = cityProviders.length + cityDoctors.length;

/** "3 clinics · 1 hospital · 2 doctors" — pluralised, omitting empty groups */
const clinicCount = cityProviders.filter((p) => p.type === "clinic").length;
const hospitalCount = cityProviders.length - clinicCount;
const headMeta = [
  city.state,
  clinicCount > 0 ? `${clinicCount} ${clinicCount === 1 ? "clinic" : "clinics"}` : "",
  hospitalCount > 0 ? `${hospitalCount} ${hospitalCount === 1 ? "hospital" : "hospitals"}` : "",
  cityDoctors.length > 0
    ? `${cityDoctors.length} ${cityDoctors.length === 1 ? "doctor" : "doctors"}`
    : "",
].filter(Boolean).join(" · ");

const noindex = true; // sample dataset — published cities only in production

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Veterinary care in ${city.name}`,
  description: `Veterinary clinics, hospitals and doctors in ${city.name}, ${city.state}.`,
  about: {
    "@type": "City",
    name: city.name,
    address: { "@type": "PostalAddress", addressRegion: city.state, addressCountry: "IN" },
  },
};
---

<BaseLayout
  title={`Veterinary clinics & doctors in ${city.name}`}
  description={`Find veterinary hospitals, clinics and doctors in ${city.name}, ${city.state}. Compare specialities, fees and reviewer themes on Vetlas.`}
  noindex={noindex}
  canonical={`/${city.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="container">
    <a class="back-link mt-15" href="/locations/">
      <Icon name="back" class="icon icon-md" /> All cities
    </a>

    <header class="page-head page-head-row animate-fade-up">
      <span class="card-icon card-icon-lg">
        <Icon name="pin" class="icon icon-xl" />
      </span>
      <div>
        <h1>Veterinary care in {city.name}</h1>
        <p class="muted head-desc">
          {headMeta}
        </p>
      </div>
    </header>

    <div class="notice-box mt-1 maxw-44">
      <strong>Publication status:</strong> this city is part of the demo dataset.
      Vetlas publishes a Tier-{city.isMetro ? 1 : 2} city only once at least {tierMin} vetted
      profiles exist (spec §2). Currently showing {profileCount} sample profiles.
    </div>

    <section class="section-first" aria-labelledby="search-h">
      <h2 class="visually-hidden" id="search-h">Search within {city.name}</h2>
      <SearchBuilder compact />
    </section>

    <section class="section-first" aria-labelledby="cp-h">
      <h2 class="section-title" id="cp-h">Clinics &amp; hospitals</h2>
      <div class="mt-75"><TrustBadge level="sample" label="Sample data" /></div>
      {cityProviders.length > 0 ? (
        <ol class="ledger mt-75">
          {cityProviders.map((p, i) => (
            <ProviderLedgerRow provider={p} index={i} theme={themeFor(p.slug)} />
          ))}
        </ol>
      ) : (
        <div class="empty-state card">
          <span class="icon-wrap"><Icon name="search" class="icon icon-xl" /></span>
          <h2>Nothing here yet</h2>
          <p>We haven't mapped {city.name} in the sample dataset. Browse care across India meanwhile.</p>
          <div class="actions"><a class="btn btn-primary" href="/search/">Browse all of India</a></div>
        </div>
      )}
    </section>

    <section class="section-compact" aria-labelledby="cd-h">
      <h2 class="section-title" id="cd-h">Doctors</h2>
      {cityDoctors.length > 0 ? (
        <ol class="ledger mt-75">
          {cityDoctors.map((d, i) => (
            <DoctorLedgerRow doctor={d} index={i} theme={themeFor(d.slug)} />
          ))}
        </ol>
      ) : (
        <div class="empty-state card">
          <span class="icon-wrap"><Icon name="doctor" class="icon icon-xl" /></span>
          <h2>No doctors here yet</h2>
          <p>This city hasn't been mapped in the sample dataset yet.</p>
          <div class="actions"><a class="btn btn-primary" href="/search/">Browse all doctors</a></div>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
