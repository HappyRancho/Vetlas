---
import Layout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FacilityCard from "../../components/FacilityCard.astro";
import { cities, specialties, providersByCity, doctorsByCity } from "@data";
import { veterinarians } from "../../data/veterinarians";
export function getStaticPaths(){ return cities.map(city=>({params:{city:city.slug},props:{city}})); }
const {city}=Astro.props;
const facilities=providersByCity(city.id).sort((a,b)=>a.area.localeCompare(b.area)||a.name.localeCompare(b.name));
const species=specialties.filter(s=>facilities.some(p=>p.specialtyIds.includes(s.id)));
const doctors=doctorsByCity(city.id).length + veterinarians.filter(d=>d.cityId===city.id).length;
const path='/'+city.slug+'/';
const schema={'@context':'https://schema.org','@type':'CollectionPage',url:new URL(path,Astro.site),about:{'@type':'City',name:city.name},mainEntity:{'@type':'ItemList',itemListElement:facilities.map((p,i)=>({'@type':'ListItem',position:i+1,item:{'@id':new URL(path+p.slug+'/#facility',Astro.site).href,name:p.name}}))}};
---
<Layout noindex={!facilities.length && !doctors} title={'Veterinary clinics and hospitals in '+city.name} description={`Compare ${facilities.length} veterinary facilities in ${city.name}, ${city.state}. Find branch addresses, services, sources and directions.`}><script type="application/ld+json" set:html={JSON.stringify(schema)} />
<div class="container atlas"><Breadcrumbs items={[{name:'Cities',href:'/locations/'},{name:city.name,href:path}]}/>
<header class="city-mast"><p class="kicker">{city.state} · City directory</p><h1>Veterinary care in {city.name}</h1><p>{facilities.length} facilities, organised by neighbourhood. Check the branch address and contact the practice before travelling.</p><nav class="city-links" aria-label="Local care options"><a href={'/search/?city='+city.slug}>Filter this city</a>{doctors>0 && <a href={path+'veterinarians/'}>{doctors} veterinarian profiles</a>}{city.id==='indore'&&<a href="/map/">Indore clinic map</a>}{species.filter(s=>s.id!=='general').map(s=><a href={path+s.slug+'/'}>{s.name}</a>)}</nav></header>
<section><h2>Clinics and hospitals</h2>{!facilities.length && <p>No facilities with approved photography are published in {city.name} yet.</p>}<div class="facility-grid">{facilities.map((p,i)=><FacilityCard provider={p} index={i}/>)}</div></section></div></Layout>
