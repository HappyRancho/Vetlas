---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import FacilityCard from "../../components/FacilityCard.astro";
import VetCard from "../../components/VetCard.astro";
import { veterinarians } from "../../data/veterinarians";
import UniversalSearch from "../../components/UniversalSearch.astro";
import { cities, providersByCity } from "@data";

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const cityProviders = providersByCity(city.id);
const cityDoctors = veterinarians.filter(v=>v.cityId===city.id);


const clinicCount = cityProviders.filter((p) => p.type === "clinic").length;
const hospitalCount = cityProviders.length - clinicCount;
const headMeta = [
  city.state,
  clinicCount > 0 ? `${clinicCount} ${clinicCount === 1 ? "clinic" : "clinics"}` : "",
  hospitalCount > 0 ? `${hospitalCount} ${hospitalCount === 1 ? "hospital" : "hospitals"}` : "",
  cityDoctors.length > 0
    ? `${cityDoctors.length} ${cityDoctors.length === 1 ? "doctor" : "doctors"}`
    : "",
].filter(Boolean).join(" · ");

const noindex = city.id !== "indore"; // keep discovery pages noindex until source coverage is stronger

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Veterinary care in ${city.name}`,
  description: `Veterinary clinics, hospitals and doctors in ${city.name}, ${city.state}.`,
  about: {
    "@type": "City",
    name: city.name,
    address: { "@type": "PostalAddress", addressRegion: city.state, addressCountry: "IN" },
  },
};
---

<BaseLayout
  title={`Veterinary clinics & doctors in ${city.name}`}
  description={`Find veterinary hospitals, clinics and doctors in ${city.name}, ${city.state}. Compare specialities, facilities, fees and reviewer themes on Vetlas.`}
  noindex={noindex}
  canonical={`/${city.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="container">
    <a class="back-link mt-15" href="/locations/">
      <Icon name="back" class="icon icon-md" /> All cities
    </a>

    <header class="page-head page-head-row animate-fade-up">
      <span class="card-icon card-icon-lg">
        <Icon name="pin" class="icon icon-xl" />
      </span>
      <div>
        <p class="eyebrow">Veterinary care</p>
        <h1>{city.name}</h1>
        <p class="muted head-desc">{headMeta}</p>
      </div>
    </header>

    {city.id === "indore" && <div class="list-inline"><a class="chip" href="/map/">Explore 15 clinics on the map →</a><a class="chip" href="/indore/veterinarians/">Meet the veterinarians →</a></div>}

    <section class="section-first" aria-labelledby="search-h">
      <h2 class="visually-hidden" id="search-h">Search within {city.name} and beyond</h2>
      <UniversalSearch variant="compact" />
    </section>

    <section class="section-first" aria-labelledby="cp-h">
      <div class="section-head">
        <div>
          <p class="section-eyebrow">Facilities</p>
          <h2 class="section-title section-title-sm" id="cp-h">Hospitals &amp; clinics in {city.name}</h2>
        </div>

      </div>
      {cityProviders.length > 0 ? (
        <div class="facility-grid">
          {cityProviders.map((p, i) => <FacilityCard provider={p} index={i} />)}
        </div>
      ) : (
        <div class="empty-state card">
          <span class="icon-wrap"><Icon name="search" class="icon icon-xl" /></span>
          <h2>Nothing here yet</h2>
          <p>We haven't mapped {city.name} in the directory. Browse care across India meanwhile.</p>
          <div class="actions"><a class="btn btn-primary" href="/search/">Browse all of India</a></div>
        </div>
      )}
    </section>

    <section class="section-compact" aria-labelledby="cd-h">
      <div class="section-head">
        <div>
          <p class="section-eyebrow">Doctors</p>
          <h2 class="section-title section-title-sm" id="cd-h">Veterinarians in {city.name}</h2>
        </div>

      </div>
      {cityDoctors.length > 0 ? (
        <div class="doctor-grid">
          {cityDoctors.map(d => <VetCard vet={d} />)}
        </div>
      ) : (
        <div class="empty-state card">
          <span class="icon-wrap"><Icon name="doctor" class="icon icon-xl" /></span>
          <h2>No doctors here yet</h2>
          <p>This city hasn't been mapped in the directory yet.</p>
          <div class="actions"><a class="btn btn-primary" href="/search/?type=doctor">Browse all doctors</a></div>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
