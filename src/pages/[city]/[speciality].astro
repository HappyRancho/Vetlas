---
import SpecialityDetail from "../../components/SpecialityDetail.astro";
import {
  cities, specialties, providersByCity, doctorsByCity,
} from "@data";

export function getStaticPaths() {
  return cities.flatMap((city) =>
    specialties.filter(s => providersByCity(city.id).some(p => p.specialtyIds.includes(s.id)) || doctorsByCity(city.id).some(d => d.primarySpecialtyId === s.id || d.secondarySpecialtyIds.includes(s.id))).map((specialty) => ({
      params: { city: city.slug, speciality: specialty.slug },
      props: { city, specialty },
    }))
  );
}

---
<SpecialityDetail city={Astro.props.city} specialty={Astro.props.specialty}/>
