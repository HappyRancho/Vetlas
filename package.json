    "test:voting-api": "node scripts/test-voting-api.mjs",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test:community-ui": "node scripts/test-community-ui.cjs",
    "test:maps": "node --test scripts/test-map-data.mjs && node scripts/test-map-ui.cjs"
  },
  "dependencies": {
