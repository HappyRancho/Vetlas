{
  "name": "vetlas",
  "version": "0.1.0",
  "private": true,
  "description": "Vetlas \u2014 India's trusted veterinary care decision-support platform",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:ratings": "node --test scripts/test-ratings.mjs",
