    "astro": "^5.1.1",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.2.1",
    "typescript": "^5.5.4",
    "wrangler": "^4.162.0"
  }
}
